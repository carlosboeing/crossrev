#!/usr/bin/env bash
#
# A fake `grok` for the offline suite.
#
# It returns what the real CLI returns for `--output-format json` with
# `--json-schema`: the constrained object on `structuredOutput`, a concatenated
# draft string on `text` (which `fromjson` rejects), usage on `usage`, and
# `modelUsage` keyed by model id. That shape is what lib/adapters/grok.sh parses.
# A resolve leg runs `--output-format streaming-json` so its tool record is
# readable; the stub still answers the json shape, which the adapter reads
# through its streaming fallback, because the stub's job is to assert the
# flags rather than to re-emit the stream.
#
# It also asserts the flags the adapter is supposed to pass. `--prompt-file`
# takes a path; `-p` / `--print` / `--single` consume the next argv as the
# prompt, so using them is the same class of bug as agy's `--print`. A blanket
# bypass is never a CrossRev grant. A review leg reads as supplied with a
# tripwire: `--tools` is empty, granting no tool at all, and
# `--output-format streaming-json` leaves the tool record the tripwire reads
# as tool_call and tool_call_update events. A resolve leg edits without
# running commands: `--tools` holds the read and edit tools with no shell
# entry, and `--output-format streaming-json` leaves the tool record the
# tripwire reads. Both streaming legs leave `--json-schema` off — the flag
# implies `--output-format json` — so the model answers in text the adapter
# reads out of the stream instead of ending in one structured turn.
# Wrong flags exit 96.

set -uo pipefail

# The CROSSREV_* configuration this stub reads, restored when the parent handed
# it an allowlist rather than the whole environment. See the file for why.
# shellcheck source=tests/stub/_stub-env.sh
# tests/test-legs.sh builds a PATH of symlinks to these stubs, and BSD readlink
# has no -f, so the link is walked by hand the way bin/crossrev:16-24 does. Left
# unresolved, dirname answers the symlink's directory, _stub-env.sh is not there,
# the source fails, and the stub runs with no route table at all.
source "$(_s="${BASH_SOURCE[0]}"; while [[ -L "$_s" ]]; do _d="$(cd -P "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; [[ "$_s" != /* ]] && _s="$_d/$_s"; done; cd -P "$(dirname "$_s")" && pwd)/_stub-env.sh"


[[ "${1:-}" == "--version" ]] && { printf 'grok 1.0.5 (test stub)\n'; exit 0; }

# Every flag the adapter built, so a suite can assert what a leg was and was not
# granted. Appended, because one `crossrev run` invokes this twice.
[[ -n "${CROSSREV_ARGV_LOG:-}" ]] && printf '%s\n' "$*" >>"$CROSSREV_ARGV_LOG"

if [[ -n "${CROSSREV_GROK_UNAUTH:-}" ]]; then
  printf 'Error: Not signed in. Alternatively, set the `XAI_API_KEY` environment variable or run `grok login`.\n' >&2
  exit 1
fi

prompt_file=""
schema=""
perm=""
sandbox=""
allow_edit=0
allow_write=0
deny_edit=0
deny_write=0
format=""
tools=""
tools_seen=0
requested=""

while (( $# )); do
  case "$1" in
    -p|--print|--single)
      printf 'test stub: %s consumes the next argv as the prompt; use --prompt-file\n' "$1" >&2
      exit 96
      ;;
    --always-approve|--yolo|--dangerously-skip-permissions)
      printf 'test stub: %s is a blanket bypass and must not be passed\n' "$1" >&2
      exit 96
      ;;
    --prompt-file)
      prompt_file="${2:-}"; shift 2 ;;
    --json-schema)
      schema="${2:-}"
      if [[ "$schema" == /* ]]; then
        printf 'test stub: --json-schema takes inline JSON, not a path\n' >&2
        exit 96
      fi
      shift 2
      ;;
    --permission-mode)
      perm="${2:-}"
      if [[ "$perm" == "bypassPermissions" ]]; then
        printf 'test stub: bypassPermissions is a blanket bypass and must not be passed\n' >&2
        exit 96
      fi
      shift 2
      ;;
    --sandbox)
      sandbox="${2:-}"; shift 2 ;;
    --allow)
      [[ "${2:-}" == "Edit" ]] && allow_edit=1
      [[ "${2:-}" == "Write" ]] && allow_write=1
      shift 2
      ;;
    --deny)
      [[ "${2:-}" == "Edit" ]] && deny_edit=1
      [[ "${2:-}" == "Write" ]] && deny_write=1
      shift 2
      ;;
    --model)
      requested="${2:-}"; shift 2 ;;
    --output-format)
      format="${2:-}"; shift 2 ;;
    --tools)
      tools="${2:-}"; tools_seen=1; shift 2 ;;
    --reasoning-effort|--effort|--disallowed-tools|--rules|--system-prompt-override|--system-prompt)
      shift 2 ;;
    *)
      shift ;;
  esac
done

if [[ -z "$prompt_file" || ! -f "$prompt_file" ]]; then
  printf 'test stub: --prompt-file is required and must name a real file\n' >&2
  exit 96
fi
if [[ "$perm" != "dontAsk" ]]; then
  printf 'test stub: --permission-mode must be dontAsk, not %s\n' "${perm:-unset}" >&2
  exit 96
fi

prompt="$(cat "$prompt_file")"
[[ -n "${CROSSREV_PROMPT_LOG:-}" ]] && printf '%s' "$prompt" >"$CROSSREV_PROMPT_LOG"

if [[ "$prompt" == *"You are the review leg"* ]]; then
  if [[ "$sandbox" != "read-only" || "$deny_edit" -ne 1 || "$deny_write" -ne 1 ]]; then
    printf 'test stub: a review leg needs --sandbox read-only --deny Edit --deny Write\n' >&2
    exit 96
  fi
  if [[ "$allow_edit" -eq 1 || "$allow_write" -eq 1 ]]; then
    printf 'test stub: a review leg must not pass --allow Edit or --allow Write\n' >&2
    exit 96
  fi
  if [[ "$format" != "streaming-json" ]]; then
    printf 'test stub: a supplied review leg needs --output-format streaming-json, not %s\n' "${format:-unset}" >&2
    exit 96
  fi
  if [[ -n "$schema" ]]; then
    printf 'test stub: a streaming review leg must not pass --json-schema, which implies --output-format json\n' >&2
    exit 96
  fi
  # A supplied review grants no tool at all: Grep returns file content and
  # Glob enumerates paths over the checkout, and neither carries a command
  # the tripwire would catch. Deny rules alone did not remove the shell in
  # the measured run, so the empty allowlist is what denies.
  if [[ "$tools_seen" -ne 1 ]]; then
    printf 'test stub: a supplied review leg needs a --tools allowlist\n' >&2
    exit 96
  fi
  if [[ -n "$tools" ]]; then
    printf 'test stub: a supplied review leg grants no tools, got %s\n' "$tools" >&2
    exit 96
  fi
elif [[ "$prompt" == *"You are the resolve leg"* ]]; then
  if [[ "$sandbox" != "workspace" || "$allow_edit" -ne 1 || "$allow_write" -ne 1 ]]; then
    printf 'test stub: a resolve leg needs --sandbox workspace --allow Edit --allow Write\n' >&2
    exit 96
  fi
  if [[ -n "$schema" ]]; then
    printf 'test stub: a resolve leg must not pass --json-schema, so the model edits before it answers\n' >&2
    exit 96
  fi
  if [[ "$format" != "streaming-json" ]]; then
    printf 'test stub: a resolve leg needs --output-format streaming-json, not %s\n' "${format:-unset}" >&2
    exit 96
  fi
  if [[ "$tools" != *"Edit"* || "$tools" != *"Write"* ]]; then
    printf 'test stub: a resolve leg needs a --tools allowlist holding Edit and Write, not %s\n' "${tools:-unset}" >&2
    exit 96
  fi
  for banned in Bash bash shell run_terminal_command; do
    if [[ "$tools" == *"$banned"* ]]; then
      printf 'test stub: the --tools allowlist must leave the shell out, got %s\n' "$tools" >&2
      exit 96
    fi
  done
fi

payload_file="${CROSSREV_HARNESS_PAYLOAD:-}"
if [[ "$prompt" == *"You are the review leg"* ]]; then
  [[ -n "${CROSSREV_REVIEW_PAYLOAD:-}" ]] && payload_file="$CROSSREV_REVIEW_PAYLOAD"
elif [[ "$prompt" == *"You are the resolve leg"* ]]; then
  [[ -n "${CROSSREV_RESOLVE_PAYLOAD:-}" ]] && payload_file="$CROSSREV_RESOLVE_PAYLOAD"
fi

if [[ -z "$payload_file" || ! -f "$payload_file" ]]; then
  jq -cn '{text:"no canned payload was set for this stub invocation", stopReason:"error"}'
  exit 1
fi

if [[ "$prompt" == *"You are the resolve leg"* && -n "${CROSSREV_RESOLVE_EDIT:-}" ]]; then
  bash "$CROSSREV_RESOLVE_EDIT" || true
fi

model="${requested:-grok-test-model}"
# text concatenates the payload twice the way live grok 1.0.5 concatenates
# draft JSON objects. fromjson of that string is null; the adapter must read
# structuredOutput instead.
jq -cn --arg r "$(cat "$payload_file")" --arg m "$model" \
  '{text:($r + $r), structuredOutput:($r | fromjson),
    stopReason:"end_turn", sessionId:"stub", requestId:"stub",
    num_turns:1,
    usage:{input_tokens:3, output_tokens:4, cache_read_input_tokens:0,
           cache_creation_input_tokens:0, reasoning_tokens:0, total_tokens:7},
    modelUsage:{($m):{inputTokens:3, outputTokens:4,
                      cacheReadInputTokens:0, modelCalls:1}}}'
