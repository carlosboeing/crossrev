#!/usr/bin/env bash
#
# A fake `gh` for the offline suite.
#
# crossrev keeps its whole GitHub boundary in lib/github.sh and lib/state.sh, so
# putting this earlier on PATH exercises the real call sites — the real argument
# shapes, the real jq expressions, the real ordering — with no network and no pull
# request. Every invocation is logged, so a test can assert on what crossrev *did*
# rather than only on what it printed.
#
# Routes are matched in file order, so a test adds the specific ones first.

set -uo pipefail

# The CROSSREV_* configuration this stub reads, restored when the parent handed
# it an allowlist rather than the whole environment. See the file for why.
# shellcheck source=tests/stub/_stub-env.sh
# tests/test-legs.sh builds a PATH of symlinks to these stubs, and BSD readlink
# has no -f, so the link is walked by hand the way bin/crossrev:16-24 does. Left
# unresolved, dirname answers the symlink's directory, _stub-env.sh is not there,
# the source fails, and the stub runs with no route table at all.
source "$(_s="${BASH_SOURCE[0]}"; while [[ -L "$_s" ]]; do _d="$(cd -P "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; [[ "$_s" != /* ]] && _s="$_d/$_s"; done; cd -P "$(dirname "$_s")" && pwd)/_stub-env.sh"


joined="$*"
[[ -n "${CROSSREV_GH_LOG:-}" ]] && printf '%s\n' "$joined" >>"$CROSSREV_GH_LOG"

# Honour --jq, because a lot of crossrev's reads rely on it and a stub that
# ignored it would be testing a different program.
jq_expr=""
prev=""
for a in "$@"; do
  [[ "$prev" == "--jq" ]] && { jq_expr="$a"; break; }
  prev="$a"
done

emit() {
  if [[ -n "$jq_expr" ]]; then
    jq -r "$jq_expr" 2>/dev/null || true
  else
    cat
  fi
}

hash_stdin() {
  if command -v shasum >/dev/null 2>&1; then
    shasum | awk '{print $1}'
  else
    sha1sum | awk '{print $1}'
  fi
}

extract_field() {
  local prefix="$1"; shift
  local val=""
  local prev=""
  for a in "$@"; do
    if [[ "$prev" == "-f" || "$prev" == "-F" || "$prev" == "--field" || "$prev" == "--raw-field" || "$prev" == "-q" || "$prev" == "--jq" ]] && [[ "$a" == "$prefix="* ]]; then
      val="${a#"$prefix="}"
    elif [[ "$a" == "$prefix="* ]]; then
      val="${a#"$prefix="}"
    elif [[ "$a" == "-f$prefix="* ]]; then
      val="${a#"-f$prefix="}"
    elif [[ "$a" == "-F$prefix="* ]]; then
      val="${a#"-F$prefix="}"
    elif [[ "$a" == "--field=$prefix="* ]]; then
      val="${a#"--field=$prefix="}"
    elif [[ "$a" == "--raw-field=$prefix="* ]]; then
      val="${a#"--raw-field=$prefix="}"
    fi
    prev="$a"
  done
  printf '%s' "$val"
}

match_routes() {
  if [[ -f "${CROSSREV_GH_ROUTES:-/nonexistent}" ]]; then
    while IFS=$'\t' read -r pat resp; do
      [[ -n "${pat:-}" ]] || continue
      # shellcheck disable=SC2053  # the pattern is a glob on purpose
      if [[ "$joined" == $pat ]]; then
        # Checked before the pipeline, not inside it: `exit 1` on the left of a pipe
        # runs in a subshell, so the stub would exit 0 and every "this call fails"
        # fixture would silently succeed.
        [[ "${resp:-}" == "!fail" ]] && exit 1
        # Permission and policy denials, in gh's voice: a 403 for a token
        # without the scope, a 422 naming the ruleset that rejected the
        # write. The client classifies on these the way it classifies on
        # the real ones, and silent !fail stays the transient shape.
        if [[ "${resp:-}" == "!deny" ]]; then
          printf 'gh: Resource not accessible by integration (HTTP 403)\n' >&2
          exit 1
        fi
        if [[ "${resp:-}" == "!deny-ruleset" ]]; then
          printf 'gh: Validation Failed: the ref update was rejected by a ruleset (HTTP 422)\n' >&2
          exit 1
        fi
        if [[ "${resp:-}" == @* ]]; then
          cat "${resp#@}"
        else
          printf '%s\n' "${resp:-}"
        fi | emit
        exit 0
      fi
    done <"$CROSSREV_GH_ROUTES"
  fi
}

stdin_payload=""
if [[ "$joined" == *"--input -"* ]]; then
  stdin_payload="$(cat)"
fi

# Stateful coverage read-back for the Review Intelligence ledger. The ledger
# publishes a shard, reads it back by comment id, rechecks the revision,
# then publishes the manifest last — so the stub must answer what was
# written, not a static fixture. Created coverage bodies are spooled under
# CROSSREV_GH_STATE (one file per comment id); the single-comment GET and
# the paginated list GET replay them. Non-coverage comments are untouched:
# unmatched writes below still answer {}.
if [[ -n "${CROSSREV_GH_STATE:-}" ]]; then
  mkdir -p "$CROSSREV_GH_STATE"
  # The login coverage comments are attributed to. The stub cannot know it
  # from the create call (GitHub sets it server-side), so the suite exports
  # it beside the state directory and the snapshot file carries it in.
  gh_author="${CROSSREV_GH_AUTHOR:-tester}"
  # The login comments created in the run are attributed to. GitHub
  # attributes a create to the calling token, which this stand-in reads
  # back through `api user` — so a create carries the seeded user login
  # when one is seeded, and the exported author otherwise. Without this
  # every marker read that keeps only that login drops what the run
  # just stored.
  create_author="$gh_author"
  if [[ -f "$CROSSREV_GH_STATE/user.json" ]]; then
    _u="$(jq -r '.login // empty' "$CROSSREV_GH_STATE/user.json" 2>/dev/null || true)"
    [[ -n "$_u" ]] && create_author="$_u"
  elif [[ -f "$CROSSREV_GH_STATE/user" ]]; then
    _u="$(cat "$CROSSREV_GH_STATE/user")"
    if [[ "$_u" =~ ^\{.*\}$ ]]; then
      _u="$(jq -r '.login // empty' <<<"$_u" 2>/dev/null || true)"
    fi
    [[ -n "$_u" ]] && create_author="$_u"
  fi
  # The seeded pull request's number, owner and repo. Threads and labels
  # seeded without an explicit home default to these, the way the
  # pulls/<number>/comments list already defaults a missing pull_number.
  seed_pr_number="42"
  seed_repo_owner="acme"
  seed_repo_name="widget"
  if [[ -f "$CROSSREV_GH_STATE/pr.json" ]]; then
    _sn="$(jq -r '.number // empty' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || true)"
    [[ "$_sn" =~ ^[0-9]+$ ]] && seed_pr_number="$_sn"
    _so="$(jq -r '.headRepositoryOwner.login // empty' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || true)"
    [[ -n "$_so" ]] && seed_repo_owner="$_so"
    _sr="$(jq -r '.headRepository.name // empty' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || true)"
    [[ -n "$_sr" ]] && seed_repo_name="$_sr"
  fi
  seed_repo_slug="$seed_repo_owner/$seed_repo_name"
  # The state file holding one repository's label definitions, seeded
  # from labels.json on first touch so each repo starts from the same
  # catalogue but recolours and creates stay on their own repo. Only
  # writes initialise it: a read on empty state must not pin [] before
  # the seeds arrive.
  repo_labels_file() {
    local _f="$CROSSREV_GH_STATE/labels-$req_repo_key.json"
    if [[ ! -f "$_f" ]]; then
      if [[ -f "$CROSSREV_GH_STATE/labels.json" ]]; then
        cp "$CROSSREV_GH_STATE/labels.json" "$_f"
      else
        printf '[]' >"$_f"
      fi
    fi
    printf '%s' "$_f"
  }
  # The same definitions for reading: the per-repo file when one was
  # written, else the seed, else empty. Never creates anything.
  repo_labels_current() {
    local _f="$CROSSREV_GH_STATE/labels-$req_repo_key.json"
    if [[ -f "$_f" ]]; then
      cat "$_f"
    elif [[ -f "$CROSSREV_GH_STATE/labels.json" ]]; then
      cat "$CROSSREV_GH_STATE/labels.json"
    else
      printf '[]'
    fi
  }
  # One issue's labels for reading, without persisting. Falls back to
  # the matching seed so an untouched issue replays what was seeded.
  pr_labels_current() {
    local _num="$1"
    local _f="$CROSSREV_GH_STATE/pr-labels-$req_repo_key-$_num.json"
    if [[ -f "$_f" ]]; then
      cat "$_f"
    elif [[ -f "$CROSSREV_GH_STATE/pr-$_num.json" ]]; then
      jq -c '.labels // []' "$CROSSREV_GH_STATE/pr-$_num.json" 2>/dev/null || printf '[]'
    elif [[ "$_num" == "$seed_pr_number" && -f "$CROSSREV_GH_STATE/pr.json" ]]; then
      jq -c '.labels // []' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || printf '[]'
    else
      printf '[]'
    fi
  }
  # The state file holding one issue's labels, seeded from the matching
  # pr-<n>.json (or pr.json when the number is the seeded pull's own) on
  # first touch so other issues start empty rather than inheriting them.
  pr_labels_file() {
    local _num="$1"
    local _f="$CROSSREV_GH_STATE/pr-labels-$req_repo_key-$_num.json"
    if [[ ! -f "$_f" ]]; then
      local _seed="[]"
      if [[ -f "$CROSSREV_GH_STATE/pr-$_num.json" ]]; then
        _seed="$(jq -c '.labels // []' "$CROSSREV_GH_STATE/pr-$_num.json" 2>/dev/null || printf '[]')"
      elif [[ "$_num" == "$seed_pr_number" && -f "$CROSSREV_GH_STATE/pr.json" ]]; then
        _seed="$(jq -c '.labels // []' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || printf '[]')"
      fi
      printf '%s' "$_seed" >"$_f"
    fi
    printf '%s' "$_f"
  }
  # The state file prefix for one repository's git refs. Refs are
  # per-repo server-side; without the key a ref created on one repo
  # would answer reads on another.
  ref_file_prefix() {
    printf '%s' "$CROSSREV_GH_STATE/ref-$req_repo_key"
  }
  # The issue_url for this request, parsed from its path. A create stores
  # it beside the comment so both list endpoints replay which pull
  # request the comment belongs to; a fixed URL would count every
  # comment as pull request 42.
  #
  # The owner and repo for this request, from the same paths. Every
  # per-PR and per-repo state file is keyed on them (and the number),
  # so a second pull request's data never appears in the first one's
  # reads. Defaults match the seed fixtures, which name acme/widget.
  req_issue_url=""
  req_owner=""
  req_repo=""
  for _a in "$@"; do
    if [[ "$_a" =~ repos/([^/]+)/([^/]+)/issues/([0-9]+) ]]; then
      req_issue_url="https://api.github.com/repos/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/issues/${BASH_REMATCH[3]}"
      [[ -z "$req_owner" ]] && req_owner="${BASH_REMATCH[1]}"
      [[ -z "$req_repo" ]] && req_repo="${BASH_REMATCH[2]}"
    elif [[ "$_a" =~ repos/([^/[:space:]]+)/([^/[:space:]]+) ]]; then
      [[ -z "$req_owner" ]] && req_owner="${BASH_REMATCH[1]}"
      [[ -z "$req_repo" ]] && req_repo="${BASH_REMATCH[2]}"
    fi
  done
  req_owner="${req_owner:-acme}"
  req_repo="${req_repo:-widget}"
  req_repo_slug="$req_owner/$req_repo"
  # A filename-safe owner_repo key for the per-repo state files.
  req_repo_key="$(printf '%s_%s' "$req_owner" "$req_repo" | tr -c 'A-Za-z0-9._-' '_')"

  # Seed issue comments if present
  seed_comments="$CROSSREV_GH_STATE/issue-comments.json"
  [[ -f "$seed_comments" ]] || seed_comments="$CROSSREV_GH_STATE/comments.json"
  if [[ -f "$seed_comments" && ! -f "$CROSSREV_GH_STATE/.seeded-issue-comments" ]]; then
    next="$CROSSREV_GH_STATE/next-id"
    [[ -f "$next" ]] || printf '9001' >"$next"
    cur_id="$(cat "$next")"
    # One compact object per line: @tsv renders a newline inside a body as
    # the two characters backslash-n, so a multiline seed would not replay
    # what the runner wrote. The command substitution strips jq's trailing
    # newline, keeping single-line seeds byte-identical to before.
    while IFS= read -r sc_obj; do
      sc_id="$(jq -r '.id // empty' <<<"$sc_obj")"
      [[ -n "$sc_id" ]] || continue
      printf '%s' "$(jq -r '.body // ""' <<<"$sc_obj")" >"$CROSSREV_GH_STATE/comment-$sc_id"
      sc_login="$(jq -r '.user.login // empty' <<<"$sc_obj")"
      printf '%s' "${sc_login:-$create_author}" >"$CROSSREV_GH_STATE/comment-$sc_id.author"
      sc_issue="$(jq -r '.issue_url // empty' <<<"$sc_obj")"
      if [[ -z "$sc_issue" ]]; then
        if [[ -f "$CROSSREV_GH_STATE/pr.json" ]]; then
          powner="$(jq -r '.headRepositoryOwner.login // "acme"' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || echo acme)"
          prepo="$(jq -r '.headRepository.name // "widget"' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || echo widget)"
          pnum="$(jq -r '.number // 42' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || echo 42)"
          sc_issue="https://api.github.com/repos/$powner/$prepo/issues/$pnum"
        else
          sc_issue="https://api.github.com/repos/acme/widget/issues/42"
        fi
      fi
      printf '%s' "$sc_issue" >"$CROSSREV_GH_STATE/comment-$sc_id.issue"
      if (( sc_id >= cur_id )); then
        cur_id=$(( sc_id + 1 ))
      fi
    done < <(jq -c '.[]' "$seed_comments" 2>/dev/null || true)
    printf '%s' "$cur_id" >"$next"
    : >"$CROSSREV_GH_STATE/.seeded-issue-comments"
  fi

  # Initialize next-id past any seeded review thread comment databaseId
  if [[ -f "$CROSSREV_GH_STATE/threads.json" && ! -f "$CROSSREV_GH_STATE/.seeded-threads" ]]; then
    next="$CROSSREV_GH_STATE/next-id"
    [[ -f "$next" ]] || printf '9001' >"$next"
    cur_id="$(cat "$next")"
    max_tid="$(jq -r '[.[].comments.nodes[].databaseId // 0] | max // 0' "$CROSSREV_GH_STATE/threads.json" 2>/dev/null || echo 0)"
    if (( max_tid >= cur_id )); then
      printf '%s' "$(( max_tid + 1 ))" >"$next"
    fi
    : >"$CROSSREV_GH_STATE/.seeded-threads"
  fi

  # A coverage create: POST .../issues/42/comments with a crossrev:c marker
  # in the body. Spool the body and answer the next comment id.
  if [[ "$joined" == "api --method POST repos/"*"/issues/"*"/comments"* ]]; then
    body=""
    for a in "$@"; do
      [[ "$a" == body=* ]] && body="${a#body=}"
    done
    if [[ "$body" == *"crossrev:c"* ]]; then
      next="$CROSSREV_GH_STATE/next-id"
      [[ -f "$next" ]] || printf '9001' >"$next"
      id="$(cat "$next")"
      printf '%s' "$(( id + 1 ))" >"$next"
      printf '%s' "$body" >"$CROSSREV_GH_STATE/comment-$id"
      printf '%s' "$create_author" >"$CROSSREV_GH_STATE/comment-$id.author"
      iu="${req_issue_url:-https://api.github.com/repos/acme/widget/issues/42}"
      printf '%s' "$iu" >"$CROSSREV_GH_STATE/comment-$id.issue"
      printf '{"id":%s}\n' "$id" | emit
      exit 0
    fi
  fi
  # Single-comment read-back: api repos/<slug>/issues/comments/<id>.
  # The id is unique, but the path still names a repo: a comment stored
  # on one repo 404s when read through another's, the way the API does.
  if [[ "$joined" == "api repos/"*"/issues/comments/"* ]]; then
    id="${joined##*/}"
    id="${id%% *}"
    if [[ -f "$CROSSREV_GH_STATE/comment-$id" ]]; then
      if [[ -f "$CROSSREV_GH_STATE/comment-$id.issue" ]]; then
        stored_issue="$(cat "$CROSSREV_GH_STATE/comment-$id.issue")"
        if [[ "$stored_issue" != *"repos/$req_owner/$req_repo/issues/"* ]]; then
          match_routes
          printf '{"message":"Not Found"}\n' >&2
          exit 1
        fi
      fi
      ca="$gh_author"
      [[ -f "$CROSSREV_GH_STATE/comment-$id.author" ]] && ca="$(cat "$CROSSREV_GH_STATE/comment-$id.author")"
      jq -cn --argjson id "$id" --arg body "$(cat "$CROSSREV_GH_STATE/comment-$id")" --arg a "$ca" \
        '{id:$id, body:$body, user:{login:$a}, created_at:"2026-09-09T00:00:00Z"}' | emit
      exit 0
    fi
    match_routes
    printf '{"message":"Not Found"}\n' >&2
    exit 1
  fi
  # Paginated comment list: merge the spooled coverage comments over the
  # static baseline, the way the API answers comments the run just created.
  # Without this the ledger could never see the generation the same run
  # published, and every first run would block where production converges.
  # A test that pins the list (replay_ledger) writes the frozen guard, and
  # the static route answers alone.
  if [[ "$joined" == "api --paginate repos/"*"/issues/"*"/comments"* && ! -f "$CROSSREV_GH_STATE/frozen" ]]; then
    spool="[]"
    # Ordered by the numeric id in the comment-<id> basename only:
    # sorting the full path on hyphens miscounts when the state
    # directory itself holds one, and marker parsing reads list order
    # as chronology.
    while IFS=$'\t' read -r cid f; do
      [[ -e "$f" ]] || continue
      ca="$gh_author"
      [[ -f "$CROSSREV_GH_STATE/comment-$cid.author" ]] && ca="$(cat "$CROSSREV_GH_STATE/comment-$cid.author")"
      iu="https://api.github.com/repos/acme/widget/issues/42"
      if [[ -f "$CROSSREV_GH_STATE/comment-$cid.issue" ]]; then
        iu="$(cat "$CROSSREV_GH_STATE/comment-$cid.issue")"
      else
        printf '%s' "$iu" >"$CROSSREV_GH_STATE/comment-$cid.issue"
      fi
      [[ -n "$req_issue_url" && "$iu" != "$req_issue_url" ]] && continue
      spool="$(jq -c --argjson id "$cid" --arg a "$ca" --arg iu "$iu" --rawfile body "$f" \
        '. + [{id:$id, body:$body, user:{login:$a}, created_at:"2026-09-09T00:00:00Z", issue_url:$iu}]' <<<"$spool")"
    # The if, not a case: bash 3.2 misparses case with continue here.
    done < <(for _cf in "$CROSSREV_GH_STATE"/comment-[0-9]*; do
      [[ -e "$_cf" ]] || continue
      _cb="${_cf##*/}"
      _cid="${_cb#comment-}"
      if [[ "$_cid" == *[!0-9]* || -z "$_cid" ]]; then continue; fi
      printf '%s\t%s\n' "$_cid" "$_cf"
    done | sort -t$'\t' -k1,1n)
    if [[ "$spool" != "[]" ]]; then
      static="[]"
      if [[ -f "${CROSSREV_GH_ROUTES:-/nonexistent}" ]]; then
        while IFS=$'\t' read -r pat resp; do
          [[ -n "${pat:-}" ]] || continue
          # shellcheck disable=SC2053  # the pattern is a glob on purpose
          if [[ "$joined" == $pat ]]; then
            # The same sentinels match_routes honours: without them a
            # matching !fail entry is merged as JSON and the call
            # succeeds after a jq error instead of failing.
            [[ "${resp:-}" == "!fail" ]] && exit 1
            if [[ "${resp:-}" == "!deny" ]]; then
              printf 'gh: Resource not accessible by integration (HTTP 403)\n' >&2
              exit 1
            fi
            if [[ "${resp:-}" == "!deny-ruleset" ]]; then
              printf 'gh: Validation Failed: the ref update was rejected by a ruleset (HTTP 422)\n' >&2
              exit 1
            fi
            if [[ "${resp:-}" == @* ]]; then
              static="$(cat "${resp#@}")"
            else
              static="${resp:-[]}"
            fi
            break
          fi
        done <"$CROSSREV_GH_ROUTES"
      fi
      jq -cs '.[0] as $static | .[1] as $spool | ($static | map(.id)) as $sids | $static + ($spool | map(select(.id as $id | $sids | index($id) | not)))' <(printf '%s' "$static") <(printf '%s' "$spool") | emit
      exit 0
    fi
  fi
  if [[ "$joined" == "api --paginate repos/"*"/issues/"*"/comments"* ]]; then
    match_routes
    printf '[]\n' | emit
    exit 0
  fi

  # General issue comment create: POST repos/<slug>/issues/<number>/comments
  if [[ "$joined" == "api --method POST repos/"*"/issues/"*"/comments"* ]]; then
    match_routes
    body=""
    for a in "$@"; do
      [[ "$a" == body=* ]] && body="${a#body=}"
    done
    [[ -z "$body" ]] && body="$(extract_field body "$@")"
    next="$CROSSREV_GH_STATE/next-id"
    [[ -f "$next" ]] || printf '9001' >"$next"
    id="$(cat "$next")"
    printf '%s' "$(( id + 1 ))" >"$next"
    printf '%s' "$body" >"$CROSSREV_GH_STATE/comment-$id"
    printf '%s' "$create_author" >"$CROSSREV_GH_STATE/comment-$id.author"
    iu="${req_issue_url:-https://api.github.com/repos/acme/widget/issues/42}"
    printf '%s' "$iu" >"$CROSSREV_GH_STATE/comment-$id.issue"
    printf '{"id":%s}\n' "$id" | emit
    exit 0
  fi

  # Issue comment edit: PATCH repos/<slug>/issues/comments/<id>
  if [[ "$joined" == "api --method PATCH repos/"*"/issues/comments/"* ]]; then
    match_routes
    id="${joined##*issues/comments/}"
    id="${id%% *}"
    body="$(extract_field body "$@")"
    if [[ -f "$CROSSREV_GH_STATE/comment-$id" ]]; then
      printf '%s' "$body" >"$CROSSREV_GH_STATE/comment-$id"
      ca="$gh_author"
      [[ -f "$CROSSREV_GH_STATE/comment-$id.author" ]] && ca="$(cat "$CROSSREV_GH_STATE/comment-$id.author")"
      jq -cn --argjson id "$id" --arg body "$body" --arg a "$ca" \
        '{id:$id, body:$body, user:{login:$a}, created_at:"2026-09-09T00:00:00Z"}' | emit
      exit 0
    fi
    printf '{}\n' | emit
    exit 0
  fi

  # Repository-wide issue comments: GET repos/<slug>/issues/comments
  if [[ "$joined" == "api --method GET repos/"*"/issues/comments"* ]]; then
    match_routes
    spool="[]"
    # Ordered by the numeric id in the comment-<id> basename only:
    # sorting the full path on hyphens miscounts when the state
    # directory itself holds one, and marker parsing reads list order
    # as chronology.
    while IFS=$'\t' read -r cid f; do
      [[ -e "$f" ]] || continue
      ca="$gh_author"
      [[ -f "$CROSSREV_GH_STATE/comment-$cid.author" ]] && ca="$(cat "$CROSSREV_GH_STATE/comment-$cid.author")"
      # The repository-wide path names no issue, so only the stored URL
      # is truthful here; the default keeps seeds without one unchanged.
      # It does name a repo, so only that repo's comments are listed: a
      # second repo's comment must not appear in the first one's reads.
      iu="https://api.github.com/repos/acme/widget/issues/42"
      [[ -f "$CROSSREV_GH_STATE/comment-$cid.issue" ]] && iu="$(cat "$CROSSREV_GH_STATE/comment-$cid.issue")"
      [[ "$iu" != *"repos/$req_owner/$req_repo/issues/"* ]] && continue
      spool="$(jq -c --argjson id "$cid" --arg a "$ca" --arg iu "$iu" --rawfile body "$f" \
        '. + [{id:$id, body:$body, user:{login:$a}, created_at:"2026-09-09T00:00:00Z", issue_url:$iu}]' <<<"$spool")"
    # The if, not a case: bash 3.2 misparses case with continue here.
    done < <(for _cf in "$CROSSREV_GH_STATE"/comment-[0-9]*; do
      [[ -e "$_cf" ]] || continue
      _cb="${_cf##*/}"
      _cid="${_cb#comment-}"
      if [[ "$_cid" == *[!0-9]* || -z "$_cid" ]]; then continue; fi
      printf '%s\t%s\n' "$_cid" "$_cf"
    done | sort -t$'\t' -k1,1n)
    req_page="$(extract_field page "$@")"
    req_per_page="$(extract_field per_page "$@")"
    [[ "$req_page" =~ ^[1-9][0-9]*$ ]] || req_page=1
    [[ "$req_per_page" =~ ^[1-9][0-9]*$ ]] || req_per_page=30

    offset=$(( (req_page - 1) * req_per_page ))
    spool="$(jq -c --argjson off "$offset" --argjson lim "$req_per_page" '.[$off : ($off + $lim)]' <<<"$spool")"
    printf '%s\n' "$spool" | emit
    exit 0
  fi

  # Git object API
  if [[ "$joined" == *"git/"* ]]; then
    match_routes

    # 1. POST /git/blobs
    if [[ "$joined" == "api --method POST repos/"*"/git/blobs"* ]]; then
      content=""
      if [[ -n "$stdin_payload" ]]; then
        content="$(jq -r '.content // ""' <<<"$stdin_payload")"
      fi
      sha="$(printf '%s' "$content" | hash_stdin)"
      printf '%s' "$content" >"$CROSSREV_GH_STATE/blob-$sha"
      printf '{"sha":"%s"}\n' "$sha" | emit
      exit 0
    fi

    # 2. GET /git/blobs/<sha>
    if [[ "$joined" == "api repos/"*"/git/blobs/"* && "$joined" != *"--method"* ]]; then
      sha="${joined##*git/blobs/}"
      sha="${sha%% *}"
      if [[ "$sha" == "corrupt00000000000000000000000000000000" || "$sha" == "corrupt-blob" ]]; then
        printf '{"sha":"%s","content":"{corrupt-json","encoding":"utf-8"}\n' "$sha" | emit
        exit 0
      fi
      if [[ -f "$CROSSREV_GH_STATE/blob-$sha" ]]; then
        content="$(cat "$CROSSREV_GH_STATE/blob-$sha")"
        jq -cn --arg sha "$sha" --arg content "$content" '{sha:$sha, content:$content, encoding:"utf-8"}' | emit
        exit 0
      fi
      printf '{"message":"Not Found"}\n' >&2
      exit 1
    fi

    # 3. POST /git/trees
    if [[ "$joined" == "api --method POST repos/"*"/git/trees"* ]]; then
      sha="$(printf '%s' "$stdin_payload" | hash_stdin)"
      printf '%s' "$stdin_payload" >"$CROSSREV_GH_STATE/tree-$sha"
      printf '{"sha":"%s"}\n' "$sha" | emit
      exit 0
    fi

    # 4. GET /git/trees/<sha>
    if [[ "$joined" == "api repos/"*"/git/trees/"* && "$joined" != *"--method"* ]]; then
      sha="${joined##*git/trees/}"
      sha="${sha%% *}"
      if [[ "$sha" == "corrupt00000000000000000000000000000000" || "$sha" == "corrupt-tree" ]]; then
        printf '{"sha":"%s","tree":[{"path":"manifest.json","type":"blob","sha":"corrupt-blob"},{"path":"records.json","type":"blob","sha":"corrupt-blob"}]}\n' "$sha" | emit
        exit 0
      fi
      if [[ -f "$CROSSREV_GH_STATE/tree-$sha" ]]; then
        tree_json="$(jq -c '.tree // []' "$CROSSREV_GH_STATE/tree-$sha")"
        jq -cn --arg sha "$sha" --argjson tree "$tree_json" '{sha:$sha, tree:$tree}' | emit
        exit 0
      fi
      printf '{"message":"Not Found"}\n' >&2
      exit 1
    fi

    # 5. POST /git/commits
    if [[ "$joined" == "api --method POST repos/"*"/git/commits"* ]]; then
      sha="$(printf '%s' "$stdin_payload" | hash_stdin)"
      printf '%s' "$stdin_payload" >"$CROSSREV_GH_STATE/commit-$sha"
      printf '{"sha":"%s"}\n' "$sha" | emit
      exit 0
    fi

    # 6. GET /git/commits/<sha>
    if [[ "$joined" == "api repos/"*"/git/commits/"* && "$joined" != *"--method"* ]]; then
      sha="${joined##*git/commits/}"
      sha="${sha%% *}"
      if [[ "$sha" == "corrupt00000000000000000000000000000000" ]]; then
        printf '{"sha":"corrupt00000000000000000000000000000000","tree":{"sha":"corrupt-tree"},"message":"corrupt"}\n' | emit
        exit 0
      fi
      if [[ -f "$CROSSREV_GH_STATE/commit-$sha" ]]; then
        tree="$(jq -r '.tree // ""' "$CROSSREV_GH_STATE/commit-$sha")"
        msg="$(jq -r '.message // ""' "$CROSSREV_GH_STATE/commit-$sha")"
        jq -cn --arg sha "$sha" --arg tree "$tree" --arg msg "$msg" '{sha:$sha, tree:{sha:$tree}, message:$msg}' | emit
        exit 0
      fi
      printf '{"message":"Not Found"}\n' >&2
      exit 1
    fi

    # 7. POST /git/refs
    if [[ "$joined" == "api --method POST repos/"*"/git/refs"* ]]; then
      ref=""
      sha=""
      if [[ -n "$stdin_payload" ]]; then
        ref="$(jq -r '.ref // empty' <<<"$stdin_payload")"
        sha="$(jq -r '.sha // empty' <<<"$stdin_payload")"
      fi
      if [[ -z "$ref" || -z "$sha" ]]; then
        for a in "$@"; do
          [[ "$a" == ref=* ]] && ref="${a#ref=}"
          [[ "$a" == sha=* ]] && sha="${a#sha=}"
        done
      fi
      ref_enc="$(printf '%s' "$ref" | tr '/' '_')"
      ref_no_prefix="${ref#refs/}"
      ref_enc2="$(printf '%s' "$ref_no_prefix" | tr '/' '_')"
      ref_base="$(ref_file_prefix)"
      if [[ -f "${ref_base}_$ref_enc" ]]; then
        printf '{"message":"Reference already exists"}\n' >&2
        exit 1
      fi
      jq -cn --arg ref "$ref" --arg sha "$sha" '{ref:$ref, object:{sha:$sha, type:"commit"}}' >"${ref_base}_$ref_enc"
      cp "${ref_base}_$ref_enc" "${ref_base}_$ref_enc2"
      cat "${ref_base}_$ref_enc" | emit
      exit 0
    fi

    # 8. PATCH /git/refs/<ref>
    if [[ "$joined" == "api --method PATCH repos/"*"/git/refs/"* ]]; then
      # GitHub-fidelity, live-verified 2026-09-21: `force` is a boolean.
      # `-f force=true` sends the string "true" and GitHub 422s, which is
      # how every ref update silently became a marker fallback on the
      # testbed. The client sends a JSON body with boolean force instead.
      for a in "$@"; do
        if [[ "$a" == force=* ]]; then
          printf '{"message":"Invalid request. For properties/force, \\"true\\" is not a boolean."}\n' >&2
          exit 1
        fi
      done
      if ! jq -e '.force == true' <<<"${stdin_payload:-null}" >/dev/null 2>&1; then
        printf '{"message":"Validation Failed: force must be boolean true"}\n' >&2
        exit 1
      fi
      ref_path="${joined##*git/refs/}"
      ref_path="${ref_path%% *}"
      ref="refs/${ref_path#refs/}"
      sha=""
      if [[ -n "$stdin_payload" ]]; then
        sha="$(jq -r '.sha // empty' <<<"$stdin_payload")"
      fi
      if [[ -z "$sha" ]]; then
        for a in "$@"; do
          [[ "$a" == sha=* ]] && sha="${a#sha=}"
        done
      fi
      ref_enc="$(printf '%s' "$ref" | tr '/' '_')"
      ref_no_prefix="${ref#refs/}"
      ref_enc2="$(printf '%s' "$ref_no_prefix" | tr '/' '_')"
      ref_base="$(ref_file_prefix)"
      jq -cn --arg ref "$ref" --arg sha "$sha" '{ref:$ref, object:{sha:$sha, type:"commit"}}' >"${ref_base}_$ref_enc"
      cp "${ref_base}_$ref_enc" "${ref_base}_$ref_enc2"
      cat "${ref_base}_$ref_enc" | emit
      exit 0
    fi

    # 9. GET /git/ref/<ref>
    if [[ ( "$joined" == "api repos/"*"/git/ref/"* || "$joined" == "api repos/"*"/git/refs/"* ) && "$joined" != *"--method"* ]]; then
      ref_path="${joined##*git/ref/}"
      [[ "$joined" == *"git/refs/"* ]] && ref_path="${joined##*git/refs/}"
      ref_path="${ref_path%% *}"
      ref="refs/${ref_path#refs/}"
      ref_enc="$(printf '%s' "$ref" | tr '/' '_')"
      ref_base="$(ref_file_prefix)"
      if [[ -f "${ref_base}_$ref_enc" ]]; then
        cat "${ref_base}_$ref_enc" | emit
        exit 0
      fi
      printf '{"message":"Not Found"}\n' >&2
      exit 1
    fi
  fi

  # api user --jq .login
  if [[ "$joined" == "api user"* ]]; then
    match_routes
    if [[ -f "$CROSSREV_GH_STATE/user.json" ]]; then
      cat "$CROSSREV_GH_STATE/user.json" | emit
      exit 0
    fi
    if [[ -f "$CROSSREV_GH_STATE/user" ]]; then
      u="$(cat "$CROSSREV_GH_STATE/user")"
      if [[ "$u" =~ ^\{.*\}$ ]]; then
        printf '%s\n' "$u" | emit
      else
        jq -cn --arg login "$u" '{login: $login}' | emit
      fi
      exit 0
    fi
    jq -cn --arg login "$gh_author" '{login: $login}' | emit
    exit 0
  fi

  # Pull request metadata: pr view <number> ...
  # The seed answers its own number on its own repo only: any other
  # number or repo gets the generic shape, so a second pull request's
  # title and labels never appear in the first one's reads.
  if [[ "$joined" == "pr view"* ]]; then
    match_routes
    view_num=""
    for a in "$@"; do
      [[ "$a" =~ ^[0-9]+$ ]] && { view_num="$a"; break; }
    done
    view_repo=""
    _pv=""
    for a in "$@"; do
      if [[ "$_pv" == "--repo" || "$_pv" == "-R" ]]; then view_repo="$a"; fi
      [[ "$a" == --repo=* ]] && view_repo="${a#--repo=}"
      _pv="$a"
    done
    if [[ "$view_repo" == */* ]]; then
      req_owner="${view_repo%%/*}"
      req_repo="${view_repo##*/}"
      req_repo_slug="$view_repo"
      req_repo_key="$(printf '%s_%s' "$req_owner" "$req_repo" | tr -c 'A-Za-z0-9._-' '_')"
    fi
    pr_file=""
    for a in "$@"; do
      if [[ "$a" =~ ^[0-9]+$ ]] && [[ -f "$CROSSREV_GH_STATE/pr-$a.json" ]]; then
        pr_file="$CROSSREV_GH_STATE/pr-$a.json"
        break
      fi
    done
    if [[ -z "$pr_file" && -f "$CROSSREV_GH_STATE/pr.json" ]]; then
      if [[ -z "$view_num" || "$view_num" == "$seed_pr_number" ]] && \
         [[ -z "$view_repo" || "$view_repo" == "$seed_repo_slug" ]]; then
        pr_file="$CROSSREV_GH_STATE/pr.json"
      fi
    fi

    current_pr_labels="$(pr_labels_current "${view_num:-$seed_pr_number}")"

    if [[ -n "$pr_file" ]]; then
      jq --argjson l "$current_pr_labels" '.labels = $l' "$pr_file" | emit
      exit 0
    fi

    pr_num="42"
    for a in "$@"; do
      [[ "$a" =~ ^[0-9]+$ ]] && { pr_num="$a"; break; }
    done
    jq -cn --argjson n "$pr_num" --argjson l "$current_pr_labels" \
      '{number:$n, title:"Pull Request", body:"", url:"https://github.com/acme/widget/pull/\($n)",
        headRefName:"feature", headRefOid:"0000000000000000000000000000000000000000",
        baseRefName:"main", baseRefOid:"0000000000000000000000000000000000000000",
        changedFiles:0, labels:$l, isCrossRepository:false, isDraft:false,
        headRepositoryOwner:{login:"acme"}, headRepository:{name:"widget"},
        maintainerCanModify:true, state:"OPEN"}' | emit
    exit 0
  fi

  # Check / get repo label colour: GET repos/<slug>/labels/<name>
  # Definitions live per repo: a label created on one repo 404s on another.
  if [[ "$joined" == "api repos/"*"/labels/"* && "$joined" != *"--method"* && "$joined" != *"issues/"* ]]; then
    match_routes
    lbl_name="${joined##*labels/}"
    lbl_name="${lbl_name%% *}"
    lbl_name="$(printf '%b' "${lbl_name//%/\\x}")"
    lbl="$(repo_labels_current | jq -c --arg n "$lbl_name" '.[] | select(.name == $n)' 2>/dev/null || true)"
    if [[ -n "$lbl" ]]; then
      printf '%s\n' "$lbl" | emit
      exit 0
    fi
    printf '{"message":"Not Found"}\n' >&2
    exit 1
  fi

  # Create repo label: POST repos/<slug>/labels
  if [[ ("$joined" == "api --method POST repos/"*"/labels" || "$joined" == "api --method POST repos/"*"/labels "*) && "$joined" != *"issues/"* ]]; then
    match_routes
    name="$(extract_field name "$@")"
    color="$(extract_field color "$@")"
    desc="$(extract_field description "$@")"
    color="${color:-ededed}"
    repo_defs="$(repo_labels_file)"
    updated="$(jq -c --arg n "$name" --arg c "$color" --arg d "${desc:-}" \
      '[.[] | select(.name != $n)] + [{name:$n, color:$c, description:$d}]' "$repo_defs")"
    printf '%s' "$updated" >"$repo_defs"
    jq -cn --arg n "$name" --arg c "$color" --arg d "${desc:-}" \
      '{name:$n, color:$c, description:$d}' | emit
    exit 0
  fi

  # Recolour repo label: PATCH repos/<slug>/labels/<name>
  if [[ "$joined" == "api --method PATCH repos/"*"/labels/"* && "$joined" != *"issues/"* ]]; then
    match_routes
    lbl_name="${joined##*labels/}"
    lbl_name="${lbl_name%% *}"
    lbl_name="$(printf '%b' "${lbl_name//%/\\x}")"
    color="$(extract_field color "$@")"
    repo_defs="$(repo_labels_file)"
    updated="$(jq -c --arg n "$lbl_name" --arg c "$color" \
      'map(if .name == $n then .color = $c else . end)' "$repo_defs")"
    printf '%s' "$updated" >"$repo_defs"
    lbl="$(jq -c --arg n "$lbl_name" '.[] | select(.name == $n)' "$repo_defs")"
    printf '%s\n' "${lbl:-{\}}" | emit
    exit 0
  fi

  # List repo labels: GET repos/<slug>/labels
  if [[ ("$joined" == "api repos/"*"/labels" || "$joined" == "api repos/"*"/labels "*) && "$joined" != *"--method"* && "$joined" != *"issues/"* ]]; then
    match_routes
    repo_labels_current | emit
    exit 0
  fi

  # Read PR labels: GET repos/<slug>/issues/<number>/labels
  # Labels live per owner, repo and issue number: labels added on one
  # pull request never appear on another's list.
  if [[ "$joined" == "api repos/"*"/issues/"*"/labels"* && "$joined" != *"--method"* ]]; then
    match_routes
    list_num=""
    for _a in "$@"; do
      if [[ "$_a" =~ repos/[^/]+/[^/]+/issues/([0-9]+) ]]; then
        list_num="${BASH_REMATCH[1]}"
        break
      fi
    done
    pr_labels_current "${list_num:-$seed_pr_number}" | emit
    exit 0
  fi

  # Add PR labels: POST repos/<slug>/issues/<number>/labels
  if [[ "$joined" == "api --method POST repos/"*"/issues/"*"/labels"* ]]; then
    match_routes
    add_num=""
    for _a in "$@"; do
      if [[ "$_a" =~ repos/[^/]+/[^/]+/issues/([0-9]+) ]]; then
        add_num="${BASH_REMATCH[1]}"
        break
      fi
    done
    add_state="$(pr_labels_file "${add_num:-$seed_pr_number}")"
    cur="$(cat "$add_state")"
    new_labels=()
    prev=""
    for a in "$@"; do
      if [[ "$prev" == "-f" || "$prev" == "-F" ]] && [[ "$a" == labels\[\]=* ]]; then
        new_labels+=("${a#labels\[\]=}")
      elif [[ "$a" == labels\[\]=* ]]; then
        new_labels+=("${a#labels\[\]=}")
      fi
      prev="$a"
    done
    repo_defs_add="$(repo_labels_current)"
    for nl in "${new_labels[@]}"; do
      [[ -n "$nl" ]] || continue
      col="ededed"
      found_col="$(printf '%s' "$repo_defs_add" | jq -r --arg n "$nl" '.[] | select(.name == $n) | .color' 2>/dev/null || true)"
      [[ -n "$found_col" && "$found_col" != "null" ]] && col="$found_col"
      cur="$(jq -c --arg n "$nl" --arg c "$col" \
        'if any(.name == $n) then . else . + [{name:$n, color:$c, description:""}] end' <<<"$cur")"
    done
    printf '%s' "$cur" >"$add_state"
    cat "$add_state" | emit
    exit 0
  fi

  # Remove PR labels: DELETE repos/<slug>/issues/<number>/labels/<name>
  if [[ "$joined" == "api --method DELETE repos/"*"/issues/"*"/labels/"* ]]; then
    match_routes
    lbl_name="${joined##*labels/}"
    lbl_name="${lbl_name%% *}"
    lbl_name="$(printf '%b' "${lbl_name//%/\\x}")"
    del_num=""
    for _a in "$@"; do
      if [[ "$_a" =~ repos/[^/]+/[^/]+/issues/([0-9]+) ]]; then
        del_num="${BASH_REMATCH[1]}"
        break
      fi
    done
    del_state="$(pr_labels_file "${del_num:-$seed_pr_number}")"
    cur="$(cat "$del_state")"
    cur="$(jq -c --arg n "$lbl_name" '[.[] | select(.name != $n)]' <<<"$cur")"
    printf '%s' "$cur" >"$del_state"
    printf '[]\n' | emit
    exit 0
  fi

  # List PR review comments: GET repos/<slug>/pulls/<number>/comments
  if [[ "$joined" == "api --paginate repos/"*"/pulls/"*"/comments"* ]]; then
    match_routes
    req_pull_num=""
    for _a in "$@"; do
      if [[ "$_a" =~ repos/[^/]+/[^/]+/pulls/([0-9]+) ]]; then
        req_pull_num="${BASH_REMATCH[1]}"
        break
      fi
    done
    [[ -z "$req_pull_num" ]] && req_pull_num="42"

    default_pull="42"
    if [[ -f "$CROSSREV_GH_STATE/pr.json" ]]; then
      _dp="$(jq -r '.number // empty' "$CROSSREV_GH_STATE/pr.json" 2>/dev/null || true)"
      [[ -n "$_dp" ]] && default_pull="$_dp"
    fi

    if [[ -f "$CROSSREV_GH_STATE/threads.json" ]]; then
      jq -c --argjson pnum "$req_pull_num" --argjson dp "$default_pull" \
        --arg rs "$req_repo_slug" --arg dr "$seed_repo_slug" \
        '[.[] | select(((.pull_number // $dp) == $pnum) and ((.repo // $dr) == $rs)) | .path as $p | .line as $l | .comments.nodes[] | {id:.databaseId, databaseId:.databaseId, body:.body, path:$p, line:$l, user:{login:(.author.login // "'"$create_author"'")}, created_at:"2026-09-09T00:00:00Z"}]' "$CROSSREV_GH_STATE/threads.json" | emit
      exit 0
    fi
    printf '[]\n' | emit
    exit 0
  fi

  # Reply in review thread: POST repos/<slug>/pulls/<number>/comments/<id>/replies
  if [[ "$joined" == "api --method POST repos/"*"/pulls/"*"/comments/"*"/replies"* ]]; then
    match_routes
    rbody="$(extract_field body "$@")"
    root_id="${joined##*comments/}"
    root_id="${root_id%%/*}"
    [[ -f "$CROSSREV_GH_STATE/threads.json" ]] || printf '[]' >"$CROSSREV_GH_STATE/threads.json"
    # A reply to a root that is not in state must fail before an id is
    # allocated: otherwise the call succeeds, consumes an id, and the
    # evaluation records a reply that was never stored.
    if ! jq -e --arg root "$root_id" '[.[] | .comments.nodes[]? | select((.databaseId | tostring) == $root)] | length > 0' "$CROSSREV_GH_STATE/threads.json" >/dev/null 2>&1; then
      printf '{"message":"Not Found"}\n' >&2
      exit 1
    fi
    next="$CROSSREV_GH_STATE/next-id"
    [[ -f "$next" ]] || printf '9001' >"$next"
    reply_id="$(cat "$next")"
    printf '%s' "$(( reply_id + 1 ))" >"$next"
    reply_node="$(jq -cn --argjson id "$reply_id" --arg b "$rbody" --arg a "$create_author" \
      '{databaseId:$id, body:$b, author:{login:$a}}')"
    [[ -f "$CROSSREV_GH_STATE/threads.json" ]] || printf '[]' >"$CROSSREV_GH_STATE/threads.json"
    updated="$(jq -c --argjson root "$root_id" --argjson r "$reply_node" \
      'map(if (.comments.nodes | any(.databaseId == $root)) then .comments.nodes += [$r] else . end)' \
      "$CROSSREV_GH_STATE/threads.json")"
    printf '%s' "$updated" >"$CROSSREV_GH_STATE/threads.json"
    jq -cn --argjson id "$reply_id" --arg b "$rbody" --arg a "$create_author" \
      '{id:$id, databaseId:$id, body:$b, user:{login:$a}, created_at:"2026-09-09T00:00:00Z"}' | emit
    exit 0
  fi

  # Create PR review comment: POST repos/<slug>/pulls/<number>/comments
  if [[ "$joined" == "api --method POST repos/"*"/pulls/"*"/comments"* ]]; then
    match_routes
    cbody="$(extract_field body "$@")"
    cpath="$(extract_field path "$@")"
    cline="$(extract_field line "$@")"
    req_pull_num=""
    for _a in "$@"; do
      if [[ "$_a" =~ repos/[^/]+/[^/]+/pulls/([0-9]+) ]]; then
        req_pull_num="${BASH_REMATCH[1]}"
        break
      fi
    done
    [[ -z "$req_pull_num" ]] && req_pull_num="42"
    next="$CROSSREV_GH_STATE/next-id"
    [[ -f "$next" ]] || printf '9001' >"$next"
    cid="$(cat "$next")"
    printf '%s' "$(( cid + 1 ))" >"$next"

    line_json="null"
    if [[ -n "$cline" && "$cline" =~ ^[0-9]+$ ]]; then
      line_json="$cline"
    fi

    new_comment="$(jq -cn --argjson id "$cid" --arg b "$cbody" --arg a "$create_author" \
      '{databaseId:$id, body:$b, author:{login:$a}}')"
    new_thread="$(jq -cn --arg id "RT_$cid" --argjson pull "$req_pull_num" --arg rs "$req_repo_slug" --arg p "$cpath" --argjson l "$line_json" --argjson c "$new_comment" \
      '{id:$id, pull_number:$pull, repo:$rs, isResolved:false, isOutdated:false, path:$p, line:$l, comments:{nodes:[$c]}}')"

    [[ -f "$CROSSREV_GH_STATE/threads.json" ]] || printf '[]' >"$CROSSREV_GH_STATE/threads.json"
    updated="$(jq -c --argjson t "$new_thread" '. + [$t]' "$CROSSREV_GH_STATE/threads.json")"
    printf '%s' "$updated" >"$CROSSREV_GH_STATE/threads.json"

    jq -cn --argjson id "$cid" --arg b "$cbody" --arg p "$cpath" --argjson l "$line_json" --arg a "$create_author" \
      '{id:$id, databaseId:$id, body:$b, path:$p, line:$l, user:{login:$a}, created_at:"2026-09-09T00:00:00Z"}' | emit
    exit 0
  fi

  # GraphQL reviewThreads query and resolveReviewThread mutation
  if [[ "$joined" == "api graphql"* ]]; then
    match_routes
    if [[ "$joined" == *"reviewThreads"* ]]; then
      [[ -f "$CROSSREV_GH_STATE/threads.json" ]] || printf '[]' >"$CROSSREV_GH_STATE/threads.json"
      # The query names its pull request (-F number=<pull>); only that
      # pull's threads answer, defaulting a seeded thread to the seeded
      # pull the way pulls/<number>/comments already does.
      q_number="$(extract_field number "$@")"
      [[ "$q_number" =~ ^[0-9]+$ ]] || q_number="$seed_pr_number"
      q_owner="$(extract_field owner "$@")"
      q_name="$(extract_field name "$@")"
      q_repo="${q_owner:-$seed_repo_owner}/${q_name:-$seed_repo_name}"
      threads="$(jq -c --argjson pnum "$q_number" --arg qr "$q_repo" \
        --argjson dp "$seed_pr_number" --arg dr "$seed_repo_slug" \
        '[.[] | select(((.pull_number // $dp) == $pnum) and ((.repo // $dr) == $qr))]' \
        "$CROSSREV_GH_STATE/threads.json")"
      jq -cn --argjson t "$threads" \
        '{data:{repository:{pullRequest:{reviewThreads:{nodes:($t | map(del(.pull_number, .repo)))}}}}}' | emit
      exit 0
    fi
    if [[ "$joined" == *"resolveReviewThread"* || "$joined" == *"threadId="* ]]; then
      tid="$(extract_field threadId "$@")"
      [[ -f "$CROSSREV_GH_STATE/threads.json" ]] || printf '[]' >"$CROSSREV_GH_STATE/threads.json"
      # An unknown thread id must fail: answering isResolved:true while
      # leaving state unchanged records a resolution that never happened.
      if [[ -z "$tid" ]] || ! jq -e --arg id "$tid" 'map(select(.id == $id)) | length > 0' "$CROSSREV_GH_STATE/threads.json" >/dev/null 2>&1; then
        printf '{"errors":[{"message":"Could not resolve to a node with the given id"}]}\n' >&2
        exit 1
      fi
      updated="$(jq -c --arg id "$tid" \
        'map(if .id == $id then .isResolved = true else . end)' "$CROSSREV_GH_STATE/threads.json")"
      printf '%s' "$updated" >"$CROSSREV_GH_STATE/threads.json"
      printf '{"data":{"resolveReviewThread":{"thread":{"isResolved":true}}}}\n' | emit
      exit 0
    fi
  fi

  # Check runs for a commit: GET repos/<slug>/commits/<sha>/check-runs.
  # The route table wins when it matches, so a case scripts a refusal
  # with !fail or !deny and a truncation with a total above its runs;
  # otherwise a seeded check-runs.json answers, paginated the way the
  # endpoint paginates; otherwise the commit carries no runs.
  if [[ "$joined" == "api repos/"*"/commits/"*"/check-runs"* ]]; then
    match_routes
    page="$(extract_field page "$@")"
    [[ "$page" =~ ^[0-9]+$ ]] || page="1"
    per_page="$(extract_field per_page "$@")"
    [[ "$per_page" =~ ^[0-9]+$ ]] || per_page="100"
    if [[ -f "$CROSSREV_GH_STATE/check-runs.json" ]]; then
      jq -c --argjson page "$page" --argjson per "$per_page" \
        '{total_count: length, check_runs: .[(($page - 1) * $per):($page * $per)]}' \
        "$CROSSREV_GH_STATE/check-runs.json" | emit
      exit 0
    fi
    printf '{"total_count":0,"check_runs":[]}\n' | emit
    exit 0
  fi
fi

match_routes

# Unmatched writes succeed and return nothing useful, which is the honest default:
# a test that cares asserts on the log.
printf '{}\n' | emit
exit 0
