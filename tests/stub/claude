#!/usr/bin/env bash
#
# A fake `claude` for the offline suite.
#
# It returns what the real CLI returns for `-p --output-format json`: the payload
# as a JSON *string* in `result`, plus `modelUsage` keyed by the answering model.
# That shape matters — it is what lib/adapters/claude.sh parses, and layer two of
# the divergence guard reads the key.
#
# The leg is inferred from the prompt rather than from a flag, so one stub covers
# `crossrev run` calling both legs in sequence.

set -uo pipefail

[[ "${1:-}" == "--version" ]] && { printf '9.9.9 (test stub)\n'; exit 0; }

prompt="${!#}"
[[ -n "${CROSSREV_PROMPT_LOG:-}" ]] && printf '%s' "$prompt" >"$CROSSREV_PROMPT_LOG"
# Every flag the adapter built, so a suite can assert what a leg was and was not
# granted. Appended, because one `crossrev run` invokes this twice.
[[ -n "${CROSSREV_ARGV_LOG:-}" ]] && printf '%s\n' "$*" >>"$CROSSREV_ARGV_LOG"

# The answering model defaults to the one that was asked for, which is what the
# real CLI reports when nothing substitutes it. A stub that answered as something
# else made every run look like a server-side substitution, which the run-details
# table now calls out in bold — correctly, and on a fixture that never meant it.
# A test that wants a substitution sets CROSSREV_*_MODEL and gets one.
requested=""
prev=""
for a in "$@"; do
  [[ "$prev" == "--model" ]] && { requested="$a"; break; }
  prev="$a"
done

payload_file="${CROSSREV_HARNESS_PAYLOAD:-}"
model="${CROSSREV_HARNESS_MODEL:-${requested:-claude-test-model}}"
if [[ "$prompt" == *"You are the review leg"* ]]; then
  [[ -n "${CROSSREV_REVIEW_PAYLOAD:-}" ]] && payload_file="$CROSSREV_REVIEW_PAYLOAD"
  model="${CROSSREV_REVIEW_MODEL:-$model}"
elif [[ "$prompt" == *"You are the resolve leg"* ]]; then
  [[ -n "${CROSSREV_RESOLVE_PAYLOAD:-}" ]] && payload_file="$CROSSREV_RESOLVE_PAYLOAD"
  model="${CROSSREV_RESOLVE_MODEL:-$model}"
  # A leg that retries invokes this twice, and a test about the retry needs the
  # second answer to differ from the first — otherwise "it retried" and "it
  # accepted the first answer" look identical. The counter is a file because each
  # invocation is its own process.
  if [[ -n "${CROSSREV_RESOLVE_PAYLOAD_2:-}" && -n "${CROSSREV_STUB_COUNT:-}" ]]; then
    n=$(( $(cat "$CROSSREV_STUB_COUNT" 2>/dev/null || printf 0) + 1 ))
    printf '%s' "$n" >"$CROSSREV_STUB_COUNT"
    (( n >= 2 )) && payload_file="$CROSSREV_RESOLVE_PAYLOAD_2"
  fi
fi

if [[ -z "$payload_file" || ! -f "$payload_file" ]]; then
  jq -cn '{is_error:true, result:"no canned payload was set for this stub invocation"}'
  exit 1
fi

# A resolver changes code in the working tree, and the orchestrator commits it.
# A test that needs that models it with a script rather than pretending.
if [[ "$prompt" == *"You are the resolve leg"* && -n "${CROSSREV_RESOLVE_EDIT:-}" ]]; then
  bash "$CROSSREV_RESOLVE_EDIT" || true
fi

# modelUsage carries all four counters the real CLI reports, because pricing
# sums them into the usage record and a fixture with only one would let a
# regression through that drops the other three. The .usage block carries the
# write-TTL split and thinking count the adapter reads beside modelUsage; its
# split is zero, so the 5 cacheCreationInputTokens surface as unsplit writes.
# total_cost_usd is what the run-details table shows as ~$0.12.
jq -cn --arg r "$(cat "$payload_file")" --arg m "$model" \
  '{result:$r, is_error:false, provider:"stub", total_cost_usd:0.12,
    modelUsage:{($m):{inputTokens:1200, outputTokens:300,
                      cacheReadInputTokens:40000, cacheCreationInputTokens:5,
                      canonicalModel:$m}},
    usage:{cache_creation:{ephemeral_5m_input_tokens:0,
                           ephemeral_1h_input_tokens:0},
           output_tokens_details:{thinking_tokens:0}}}'
