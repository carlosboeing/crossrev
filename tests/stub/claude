#!/usr/bin/env bash
#
# A fake `claude` for the offline suite.
#
# It returns what the real CLI returns for `-p --output-format json`: the payload
# as a JSON *string* in `result`, plus `modelUsage` keyed by the answering model.
# That shape matters — it is what lib/adapters/claude.sh parses, and layer two of
# the divergence guard reads the key.
#
# Asked for `--output-format stream-json`, it answers the stream shape instead:
# the final result event carrying the same answer and the same counters, which
# is what a served review leg and every resolve leg read. The counters match
# the buffered shape exactly, so suites asserting usage prove both shapes.
#
# The leg is inferred from the prompt rather than from a flag, so one stub covers
# `crossrev run` calling both legs in sequence.

set -uo pipefail

# The CROSSREV_* configuration this stub reads, restored when the parent handed
# it an allowlist rather than the whole environment. See the file for why.
# shellcheck source=tests/stub/_stub-env.sh
# tests/test-legs.sh builds a PATH of symlinks to these stubs, and BSD readlink
# has no -f, so the link is walked by hand the way bin/crossrev:16-24 does. Left
# unresolved, dirname answers the symlink's directory, _stub-env.sh is not there,
# the source fails, and the stub runs with no route table at all.
source "$(_s="${BASH_SOURCE[0]}"; while [[ -L "$_s" ]]; do _d="$(cd -P "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; [[ "$_s" != /* ]] && _s="$_d/$_s"; done; cd -P "$(dirname "$_s")" && pwd)/_stub-env.sh"


[[ "${1:-}" == "--version" ]] && { printf '9.9.9 (test stub)\n'; exit 0; }

# The adapter hands the prompt on stdin and keeps every other flag on argv, so
# the stub reads stdin first and falls back to the last argument — which is
# what a direct invocation passes, with stdin closed. A terminal stdin is not
# read: waiting on it would hang a bare invocation at a terminal.
prompt=""
if [[ ! -t 0 ]]; then prompt="$(cat)"; fi
[[ -n "$prompt" ]] || prompt="${!#}"
[[ -n "${CROSSREV_PROMPT_LOG:-}" ]] && printf '%s' "$prompt" >"$CROSSREV_PROMPT_LOG"
# Every flag the adapter built, so a suite can assert what a leg was and was not
# granted. Appended, because one `crossrev run` invokes this twice.
[[ -n "${CROSSREV_ARGV_LOG:-}" ]] && printf '%s\n' "$*" >>"$CROSSREV_ARGV_LOG"

# A served child connects to the read server before it answers: the post-call
# handshake requires initialize and tools_list in the call log, so the stub
# logs the session a real CLI opens when it is handed --mcp-config. Suites
# asserting argv prove the config travels; this proves the child used it.
_mcp_config=""
_mcp_prev=""
for _mcp_arg in "$@"; do
  [[ "$_mcp_prev" == "--mcp-config" ]] && _mcp_config="$_mcp_arg"
  _mcp_prev="$_mcp_arg"
done
if [[ -n "$_mcp_config" && -f "$_mcp_config" ]]; then
  _served_log="$(jq -r '.mcpServers.crossrev.args | . as $a | range(0; length) as $i | select($a[$i] == "--log") | $a[$i+1]' "$_mcp_config" | head -n 1)"
  if [[ -n "$_served_log" ]]; then
    printf '%s\n' '{"event":"start"}' '{"event":"initialize"}' '{"event":"tools_list"}' '{"event":"end"}' >>"$_served_log"
  fi
fi

# _emit_claude answers the shape that was asked for: the buffered object for
# `--output-format json`, the final result event for stream-json. The event
# carries the same answer and the same counters, so suites asserting usage
# prove both shapes. The shape is read off the invocation, because the
# function itself runs behind a pipe with no argv of its own.
_stream_json=0
[[ "$*" == *"stream-json"* ]] && _stream_json=1
_emit_claude() {
  if (( _stream_json == 1 )); then
    # The result event carries the harness's own cost figure beside the
    # counters, the way the real CLI does: total_cost_usd is what the
    # run-details table shows as ~$0.12.
    jq -c '{type:"result", result:.result, is_error:.is_error, modelUsage:.modelUsage, usage:.usage, total_cost_usd:.total_cost_usd}'
  else
    cat
  fi
}

# The answering model defaults to the one that was asked for, which is what the
# real CLI reports when nothing substitutes it. A stub that answered as something
# else made every run look like a server-side substitution, which the run-details
# table now calls out in bold — correctly, and on a fixture that never meant it.
# A test that wants a substitution sets CROSSREV_*_MODEL and gets one.
requested=""
prev=""
for a in "$@"; do
  [[ "$prev" == "--model" ]] && { requested="$a"; break; }
  prev="$a"
done

payload_file="${CROSSREV_HARNESS_PAYLOAD:-}"
model="${CROSSREV_HARNESS_MODEL:-${requested:-claude-test-model}}"
if [[ "$prompt" == *"You are the review leg"* ]]; then
  [[ -n "${CROSSREV_REVIEW_PAYLOAD:-}" ]] && payload_file="$CROSSREV_REVIEW_PAYLOAD"
  model="${CROSSREV_REVIEW_MODEL:-$model}"
  # A pass that splits one file across calls invokes this once per call, and
  # a test about the split needs the part answers to differ from the
  # whole-file answer — otherwise "it split" and "it packed one call" look
  # identical. The counter is a file because each invocation is its own
  # process, the same mechanism the resolve leg's retry uses below.
  if [[ -n "${CROSSREV_REVIEW_PAYLOAD_2:-}" && -n "${CROSSREV_STUB_COUNT:-}" ]]; then
    n=$(( $(cat "$CROSSREV_STUB_COUNT" 2>/dev/null || printf 0) + 1 ))
    printf '%s' "$n" >"$CROSSREV_STUB_COUNT"
    [[ "$n" -ge 2 ]] && payload_file="$CROSSREV_REVIEW_PAYLOAD_2"
  fi
elif [[ "$prompt" == *"You are the resolve leg"* ]]; then
  [[ -n "${CROSSREV_RESOLVE_PAYLOAD:-}" ]] && payload_file="$CROSSREV_RESOLVE_PAYLOAD"
  model="${CROSSREV_RESOLVE_MODEL:-$model}"
  # A leg that retries invokes this twice, and a test about the retry needs the
  # second answer to differ from the first — otherwise "it retried" and "it
  # accepted the first answer" look identical. The counter is a file because each
  # invocation is its own process.
  if [[ -n "${CROSSREV_RESOLVE_PAYLOAD_2:-}" && -n "${CROSSREV_STUB_COUNT:-}" ]]; then
    n=$(( $(cat "$CROSSREV_STUB_COUNT" 2>/dev/null || printf 0) + 1 ))
    printf '%s' "$n" >"$CROSSREV_STUB_COUNT"
    (( n >= 2 )) && payload_file="$CROSSREV_RESOLVE_PAYLOAD_2"
  fi
fi

if [[ -z "$payload_file" || ! -f "$payload_file" ]]; then
  jq -cn '{is_error:true, result:"no canned payload was set for this stub invocation"}'
  exit 1
fi

# A resolver changes code in the working tree, and the orchestrator commits it.
# A test that needs that models it with a script rather than pretending.
if [[ "$prompt" == *"You are the resolve leg"* && -n "${CROSSREV_RESOLVE_EDIT:-}" ]]; then
  bash "$CROSSREV_RESOLVE_EDIT" || true
fi

# CROSSREV_CLAUDE_COMMAND makes a review leg emit a command event before its
# answer: an assistant tool_use of Bash carrying the command. The review
# tripwire must halt on it with review_leg_ran_command and publish nothing.
# A suite that genuinely wants to exercise the command path sets this to the
# command the transcript should show.
_prepend_command_event() {
  if [[ -n "${CROSSREV_CLAUDE_COMMAND:-}" && "$prompt" == *"You are the review leg"* ]]; then
    jq -cn --arg c "$CROSSREV_CLAUDE_COMMAND" \
      '{type:"assistant", message:{content:[{type:"tool_use", name:"Bash", input:{command:$c}}]}}'
  fi
}

# CROSSREV_REVIEW_MODEL_USAGE replaces the single-key modelUsage with a whole
# map, for the mixed-session case: two models on one leg, where the answering
# model has to be the largest token share rather than the first sorted key.
if [[ -n "${CROSSREV_REVIEW_MODEL_USAGE:-}" && "$prompt" == *"You are the review leg"* ]]; then
  _prepend_command_event
  jq -cn --arg r "$(cat "$payload_file")" --argjson mu "$CROSSREV_REVIEW_MODEL_USAGE" \
    '{result:$r, is_error:false, provider:"stub", total_cost_usd:0.12,
      modelUsage:$mu,
      usage:{cache_creation:{ephemeral_5m_input_tokens:0,
                             ephemeral_1h_input_tokens:0},
             output_tokens_details:{thinking_tokens:0}}}' \
    | _emit_claude
  exit 0
fi

# modelUsage carries all four counters the real CLI reports, because pricing
# sums them into the usage record and a fixture with only one would let a
# regression through that drops the other three. The .usage block carries the
# write-TTL split and thinking count the adapter reads beside modelUsage; its
# split is zero, so the 5 cacheCreationInputTokens surface as unsplit writes.
# total_cost_usd is what the run-details table shows as ~$0.12.
_prepend_command_event
jq -cn --arg r "$(cat "$payload_file")" --arg m "$model" \
  '{result:$r, is_error:false, provider:"stub", total_cost_usd:0.12,
    modelUsage:{($m):{inputTokens:1200, outputTokens:300,
                      cacheReadInputTokens:40000, cacheCreationInputTokens:5,
                      canonicalModel:$m}},
    usage:{cache_creation:{ephemeral_5m_input_tokens:0,
                           ephemeral_1h_input_tokens:0},
           output_tokens_details:{thinking_tokens:0}}}' \
  | _emit_claude
