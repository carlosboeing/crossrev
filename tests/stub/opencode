#!/usr/bin/env bash
#
# A fake `opencode` for the offline suite.
#
# It returns what the real CLI returns for `run --format json`: an NDJSON event
# stream whose answer rides on `.part.text` of `type == "text"` events, with a
# sessionID on every line. That shape is what lib/adapters/opencode.sh parses,
# for the review leg and the resolve leg alike.
#
# It also asserts the contract the adapter is supposed to meet. This harness
# grants `edit` and `bash` out of the box, so the isolation config IS the
# security story, and which shape a leg gets is the write-grant question.
# A supplied review leg is denied the five read tools outright — read, glob,
# grep, list and lsp — because the review judges the supplied prompt alone.
# Violations exit 96.

set -uo pipefail

# The CROSSREV_* configuration this stub reads, restored when the parent handed
# it an allowlist rather than the whole environment. See the file for why.
# shellcheck source=tests/stub/_stub-env.sh
# tests/test-legs.sh builds a PATH of symlinks to these stubs, and BSD readlink
# has no -f, so the link is walked by hand the way bin/crossrev:16-24 does. Left
# unresolved, dirname answers the symlink's directory, _stub-env.sh is not there,
# the source fails, and the stub runs with no route table at all.
source "$(_s="${BASH_SOURCE[0]}"; while [[ -L "$_s" ]]; do _d="$(cd -P "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; [[ "$_s" != /* ]] && _s="$_d/$_s"; done; cd -P "$(dirname "$_s")" && pwd)/_stub-env.sh"


# CROSSREV_OPENCODE_MAJOR=2 switches the stub to the 2.x contract: the probe
# reports 2.0.15, `run` requires --standalone and refuses --pure, --dir and
# --variant, and the session record answers through `session export`. Unset
# keeps the 1.x contract every existing suite was written against.
major="${CROSSREV_OPENCODE_MAJOR:-1}"

if [[ "${1:-}" == "--version" ]]; then
  if [[ "$major" == "2" ]]; then printf '2.0.15 (test stub)\n'; else printf '1.18.21 (test stub)\n'; fi
  exit 0
fi

# Isolation is checked identically for `run` and `export`: the adapter reuses
# the same env for the session-record call, and a check only on `run` would
# miss deleting that config before export.
#
# Every shape carries the fail-closed `"*": "deny"` base rule, and which leg
# runs decides one grant under it:
#
#   read-only — `"edit": "deny"`;
#   write     — `"edit": "allow"` beside the base rule, measured at 1.18.21
#               editing files in this exact form.
#
# `write` and `apply_patch` mirror that grant in both shapes, because 2.x
# splits creating a file from replacing text across them.
#
# The base rule is what holds the surface no key names: a tool a future
# opencode adds, a custom tool, and whatever an MCP server or plugin
# registers all match "*" and are denied. Dropping it to make room for an
# edit grant was tried and reverted — it left every one of those allowed —
# so a config without the rule is the bug this stub refuses. bash, task,
# skill, webfetch, websearch and external_directory stay denied in both
# shapes, and so does the .env denial inside the read map.
#
# The config also defines the agent the leg runs as: agent rules are appended
# after all config-file rules with last match winning, so a global
# agents.build allow overrides the file's deny unless the leg is pinned to
# its own agent. The agent block mirrors the leg's grant for the same reason
# the top level does, and the leg passes --agent to run as it.
_assert_isolation() {
  local cfg="${OPENCODE_CONFIG:-}" cfg_content key
  cfg_content="$(tr -d '[:space:]' <"$cfg" 2>/dev/null || true)"
  if [[ -z "$cfg" || ! -r "$cfg" ]]; then
    printf 'test stub: OPENCODE_CONFIG must name a readable isolation config\n' >&2
    exit 96
  fi
  for key in bash task skill webfetch websearch external_directory; do
    if [[ "$cfg_content" != *"\"$key\":\"deny\""* ]]; then
      printf 'test stub: %s must stay denied in every shape\n' "$key" >&2
      exit 96
    fi
  done
  # A supplied review denies reading entirely: `"read": "deny"` with no read
  # map at all. Nothing is readable, so the .env denial inside the map is
  # moot — and glob, grep, list and lsp go with it, the five read tools.
  # Any other shape keeps the read map with its .env denial.
  if [[ "$cfg_content" == *'"read":"deny"'* ]]; then
    for key in glob grep list lsp; do
      if [[ "$cfg_content" != *"\"$key\":\"deny\""* ]]; then
        printf 'test stub: a supplied review denies reading entirely, so %s must be denied too\n' "$key" >&2
        exit 96
      fi
    done
  elif [[ "$cfg_content" != *'"*.env":"deny"'* ]]; then
    printf 'test stub: the read map must keep the .env denial\n' >&2
    exit 96
  fi
  if [[ "$cfg_content" != *'"*":"deny"'* ]]; then
    printf 'test stub: the fail-closed base rule must be present in every shape\n' >&2
    exit 96
  fi
  local edit_deny=0 edit_allow=0
  [[ "$cfg_content" == *'"edit":"deny"'* ]]  && edit_deny=1
  [[ "$cfg_content" == *'"edit":"allow"'* ]] && edit_allow=1
  if (( edit_deny == edit_allow )); then
    printf 'test stub: edit must be exactly one of deny or allow\n' >&2
    exit 96
  fi
  # 2.x splits creating a file from replacing text across write and
  # apply_patch, so each mirrors the leg's grant: a review config denying
  # edit while allowing either writer is the leak this refuses.
  local want="deny"
  (( edit_allow == 1 )) && want="allow"
  for key in write apply_patch; do
    if [[ "$cfg_content" != *"\"$key\":\"$want\""* ]]; then
      printf 'test stub: %s must mirror the edit grant, want %s\n' "$key" "$want" >&2
      exit 96
    fi
  done
  # The pinned agent carries its own block, checked structurally: a global
  # agents.build allow is appended after the file's rules, so only the
  # agent's own rules hold the leg.
  local agent_mode agent_grant
  agent_mode="$(jq -r '.agent.crossrev.mode // "absent"' "$cfg" 2>/dev/null)"
  if [[ "$agent_mode" != "primary" ]]; then
    printf 'test stub: the isolation config must define a primary crossrev agent, got %s\n' "$agent_mode" >&2
    exit 96
  fi
  for key in edit write apply_patch; do
    agent_grant="$(jq -r --arg k "$key" '.agent.crossrev.permission[$k] // "absent"' "$cfg" 2>/dev/null)"
    if [[ "$agent_grant" != "$want" ]]; then
      printf 'test stub: the pinned agent must mirror the %s grant, want %s got %s\n' "$key" "$want" "$agent_grant" >&2
      exit 96
    fi
  done
  agent_grant="$(jq -r '.agent.crossrev.permission.bash // "absent"' "$cfg" 2>/dev/null)"
  if [[ "$agent_grant" != "deny" ]]; then
    printf 'test stub: the pinned agent must deny bash, got %s\n' "$agent_grant" >&2
    exit 96
  fi
  agent_grant="$(jq -r '.agent.crossrev.permission."*" // "absent"' "$cfg" 2>/dev/null)"
  if [[ "$agent_grant" != "deny" ]]; then
    printf 'test stub: the pinned agent must keep the fail-closed base rule, got %s\n' "$agent_grant" >&2
    exit 96
  fi
  if [[ "${OPENCODE_DISABLE_PROJECT_CONFIG:-}" != "1" ]]; then
    printf 'test stub: OPENCODE_DISABLE_PROJECT_CONFIG=1 must be set so no project or parent config loads\n' >&2
    exit 96
  fi
  if [[ -z "${OPENCODE_CONFIG_DIR:-}" || ! -d "${OPENCODE_CONFIG_DIR:-}" ]]; then
    printf 'test stub: OPENCODE_CONFIG_DIR must name an existing directory\n' >&2
    exit 96
  fi
  # What a leg was actually granted beats what the adapter meant to grant, so
  # every accepted config is handed to the suite, compacted onto its own line.
  [[ -n "${CROSSREV_OPENCODE_CFG_LOG:-}" ]] && jq -c . "$cfg" >>"${CROSSREV_OPENCODE_CFG_LOG}"
}

# The export subcommand answers from the local session database in the real CLI,
# costing no model call. The adapter reads both the answering model and the
# whole-run token total from it. On 2.x it moved to `session export`, and a
# bare `export` is refused the way the real CLI would not recognise the shape.
if [[ "$major" == "2" && "${1:-}" == "export" ]]; then
  printf 'test stub: 2.x exports through `session export`, not `export`\n' >&2
  exit 96
fi
if [[ "$major" == "2" && "${1:-}" == "session" ]]; then
  [[ "${2:-}" == "export" ]] || { printf 'test stub: unexpected invocation: %s\n' "$*" >&2; exit 96; }
  shift 2
  standalone_export=""
  if [[ "${1:-}" == "--standalone" ]]; then
    standalone_export=1; shift
  fi
  if [[ "$major" == "2" && -z "$standalone_export" ]]; then
    printf 'test stub: 2.x session export runs --standalone so it does not attach to the shared service\n' >&2
    exit 96
  fi
  set -- "export" "${1:-}"
fi
if [[ "${1:-}" == "export" ]]; then
  _assert_isolation
  if [[ -n "${CROSSREV_OPENCODE_NO_EXPORT:-}" ]]; then
    printf 'export failed\n' >&2
    exit 1
  fi
  jq -cn '{info:{
    model:{id:"stub-model", providerID:"stub"},
    tokens:{input:10, output:2, reasoning:1, cache:{read:4, write:0}}}}'
  exit 0
fi

[[ "${1:-}" == "run" ]] || { printf 'test stub: unexpected invocation: %s\n' "$*" >&2; exit 96; }
shift

# Every flag the adapter built, so a suite can assert what a leg was and was not
# granted. Appended, because one `crossrev review` invokes this twice on a retry.
[[ -n "${CROSSREV_ARGV_LOG:-}" ]] && printf '%s\n' "run $*" >>"$CROSSREV_ARGV_LOG"

fmt="" dir="" pure="" standalone="" agent=""
while (( $# )); do
  case "$1" in
    --auto)
      printf 'test stub: %s is a blanket bypass and must not be passed\n' "$1" >&2
      exit 96 ;;
    --agent)
      agent="${2:-}"; shift 2
      if [[ "$agent" != "crossrev" ]]; then
        printf 'test stub: --agent must name the pinned crossrev agent, got %s\n' "$agent" >&2
        exit 96
      fi ;;
    --format) fmt="${2:-}"; shift 2 ;;
    --dir)
      if [[ "$major" == "2" ]]; then
        printf 'test stub: 2.x rejects --dir; the checkout travels as the working directory\n' >&2
        exit 96
      fi
      dir="${2:-}"; shift 2 ;;
    --pure)
      if [[ "$major" == "2" ]]; then
        printf 'test stub: 2.x rejects --pure; the run is standalone instead\n' >&2
        exit 96
      fi
      pure=1; shift ;;
    --standalone)
      if [[ "$major" != "2" ]]; then
        printf 'test stub: 1.x takes no --standalone\n' >&2
        exit 96
      fi
      standalone=1; shift ;;
    --model)
      # The real CLI takes provider/model, not a bare id — the configuration
      # docs say so, so the stub enforces it. On 2.x the effort rides along
      # as provider/model#variant, which still carries the slash.
      case "${2:-}" in
        */*) ;;
        *) printf 'test stub: %s takes provider/model, not a bare id\n' "$1" >&2; exit 96 ;;
      esac
      shift 2 ;;
    --variant)
      if [[ "$major" == "2" ]]; then
        printf 'test stub: 2.x takes no --variant; the effort rides --model\n' >&2
        exit 96
      fi
      shift 2 ;;
    --*) shift 2 ;;
    *) break ;;
  esac
done

prompt="${*:-}"
[[ -n "${CROSSREV_PROMPT_LOG:-}" ]] && printf '%s' "$prompt" >"$CROSSREV_PROMPT_LOG"

# A reading leg holds `edit` and `bash` unless something takes them away, and a
# writing leg must hold edit without losing the denials. Matched on
# whitespace-stripped content, so the check is about the keys and not about how
# the file was printed.
_assert_isolation
if [[ -z "$agent" ]]; then
  printf 'test stub: --agent crossrev is required so the leg runs as its pinned agent\n' >&2
  exit 96
fi
if [[ "$major" == "2" ]]; then
  # Standalone is what keeps the isolation config in force on 2.x: the
  # background service drops the process's OPENCODE_CONFIG, so a 2.x leg
  # without it would start unconstrained.
  if [[ -z "$standalone" ]]; then
    printf 'test stub: --standalone is required so the isolation config is honoured\n' >&2
    exit 96
  fi
else
  if [[ -z "$pure" ]]; then
    printf 'test stub: --pure is required so external plugins never load\n' >&2
    exit 96
  fi
  if [[ -z "$dir" || ! -d "$dir" ]]; then
    printf 'test stub: --dir is required and must name a real directory\n' >&2
    exit 96
  fi
fi
if [[ "$fmt" != "json" ]]; then
  printf 'test stub: --format json is required, got %s\n' "${fmt:-nothing}" >&2
  exit 96
fi

payload_file=""
if [[ "$prompt" == *"You are the review leg"* ]]; then
  [[ -n "${CROSSREV_REVIEW_PAYLOAD:-}" ]] && payload_file="$CROSSREV_REVIEW_PAYLOAD"
elif [[ "$prompt" == *"You are the resolve leg"* ]]; then
  [[ -n "${CROSSREV_RESOLVE_PAYLOAD:-}" ]] && payload_file="$CROSSREV_RESOLVE_PAYLOAD"
fi
[[ -n "$payload_file" && -f "$payload_file" ]] \
  || { printf 'test stub: no canned payload was set for this stub invocation\n' >&2; exit 1; }

# A resolve leg changes code in the working tree; the orchestrator commits what
# it changed. Same mechanism the other stubs use.
if [[ "$prompt" == *"You are the resolve leg"* && -n "${CROSSREV_RESOLVE_EDIT:-}" ]]; then
  bash "$CROSSREV_RESOLVE_EDIT" || true
fi

body="$(cat "$payload_file")"
mode="${CROSSREV_OPENCODE_MODE:-bare}"

case "$mode" in
  # The measured default: the model returns the schema-shaped JSON bare.
  bare|fenced|prose)
    case "$mode" in
      bare)   text="$body" ;;
      fenced) text=$'\`\`\`json\n'"$body"$'\n\`\`\`' ;;
      prose)  text="Here is the answer you asked for:
$body
Let me know if you need anything else." ;;
    esac
    jq -cn --arg t "$text" '{type:"step_start", part:{}, sessionID:"stub-session"}'
    jq -cn --arg t "$text" '{type:"text", part:{text:$t}, sessionID:"stub-session"}'
    jq -cn '{type:"step_finish", part:{tokens:{input:3, output:1}}, sessionID:"stub-session"}'
    ;;
  # Two text events with the seam inside a JSON string. jq -r would inject a
  # newline there; join-output concatenates so extraction still parses.
  split)
    case "$body" in
      *"Unchecked fetch response"*)
        left="${body%%Unchecked fetch response*}Unchecked "
        right="fetch response${body#*Unchecked fetch response}" ;;
      *)
        printf 'test stub: split mode needs Unchecked fetch response in the payload\n' >&2
        exit 96 ;;
    esac
    jq -cn '{type:"step_start", part:{}, sessionID:"stub-session"}'
    jq -cn --arg t "$left" '{type:"text", part:{text:$t}, sessionID:"stub-session"}'
    jq -cn --arg t "$right" '{type:"text", part:{text:$t}, sessionID:"stub-session"}'
    jq -cn '{type:"step_finish", part:{tokens:{input:3, output:1}}, sessionID:"stub-session"}'
    ;;
  # No answer at all: the stream carries events but no text event.
  empty)
    jq -cn '{type:"step_start", part:{}, sessionID:"stub-session"}'
    jq -cn '{type:"step_finish", part:{tokens:{input:3, output:0}}, sessionID:"stub-session"}'
    ;;
  # An authentication failure, as measured: a single error event on stdout and
  # AI_APICallError naming Unauthorized on stderr.
  error)
    printf '{"type":"error"}\n'
    printf 'AI_APICallError: Unauthorized\n' >&2
    exit 1
    ;;
  # An error event that is not a credential rejection: rate limit, overload,
  # tool failure. Must not be classified as opencode auth login.
  error-other)
    printf '{"type":"error"}\n'
    printf 'Error: Provider overloaded\n' >&2
    exit 1
    ;;
  # Prose with no braces anywhere. Extraction returns null; that is the
  # handoff that spends the extra shape-retry schema_native: false arms.
  nojson)
    jq -cn '{type:"step_start", part:{}, sessionID:"stub-session"}'
    jq -cn --arg t "I cannot produce JSON for this. Here is a review in prose with no object at all." \
      '{type:"text", part:{text:$t}, sessionID:"stub-session"}'
    jq -cn '{type:"step_finish", part:{tokens:{input:3, output:1}}, sessionID:"stub-session"}'
    ;;
  *)
    printf 'test stub: unknown CROSSREV_OPENCODE_MODE %s\n' "$mode" >&2
    exit 96 ;;
esac
