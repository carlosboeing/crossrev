#!/usr/bin/env bash
#
# crossrev — cross-model PR review loop.
#
# One model reviews a pull request, a second verifies and resolves each finding,
# then the first looks again. Runs from a terminal against any PR you can
# already see, and on GitHub Actions once `crossrev init` has set it up.
#
# Three words, each meaning one thing: a CYCLE contains PASSES, and a pass has
# two LEGS.

set -euo pipefail

# install.sh symlinks this into PATH, so BASH_SOURCE is usually a symlink and
# lib/ is relative to the real file. BSD readlink has no -f, so walk it.
_resolve() {
  local src="$1" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

ROOT="$(cd "$(_resolve "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ROOT

# shellcheck source=lib/ui.sh
source "$ROOT/lib/ui.sh"
# shellcheck source=lib/harnesses.sh
source "$ROOT/lib/harnesses.sh"
# shellcheck source=lib/preflight.sh
source "$ROOT/lib/preflight.sh"
# shellcheck source=lib/auth.sh
source "$ROOT/lib/auth.sh"
# shellcheck source=lib/config.sh
source "$ROOT/lib/config.sh"
# shellcheck source=lib/credentials.sh
source "$ROOT/lib/credentials.sh"
# shellcheck source=lib/sandbox.sh
source "$ROOT/lib/sandbox.sh"
# shellcheck source=lib/diff.sh
source "$ROOT/lib/diff.sh"
# shellcheck source=lib/state.sh
source "$ROOT/lib/state.sh"
# shellcheck source=lib/legs.sh
source "$ROOT/lib/legs.sh"
# shellcheck source=lib/github.sh
source "$ROOT/lib/github.sh"
# shellcheck source=lib/validate.sh
source "$ROOT/lib/validate.sh"
# shellcheck source=lib/prompt.sh
source "$ROOT/lib/prompt.sh"
# shellcheck source=lib/run.sh
source "$ROOT/lib/run.sh"
# shellcheck source=lib/init.sh
source "$ROOT/lib/init.sh"
# shellcheck source=lib/adapters/claude.sh
source "$ROOT/lib/adapters/claude.sh"
# shellcheck source=lib/adapters/codex.sh
source "$ROOT/lib/adapters/codex.sh"
# shellcheck source=lib/adapters/agy.sh
source "$ROOT/lib/adapters/agy.sh"

crossrev_version() { tr -d '[:space:]' <"$ROOT/VERSION"; }

usage() {
  cat <<'EOF'

  crossrev — cross-model PR review loop

  Review a pull request with one model, resolve the findings with another.

  USAGE
    crossrev <command> [options]
    crossrev --pr <n>         A cycle, which is what you want most of the time

  COMMANDS
    cycle --pr <n>           The whole loop in one process, up to max_passes_per_cycle
    review --pr <n>          One review leg: post findings as inline comments
    resolve --pr <n>         Verify each finding, fix or push back, reply, push
    status --pr <n>          Read the loop's state off the pull request
    init                     Set up automated mode: App, secrets, labels, workflows
    watchdog                 Find pull requests stuck waiting on a leg, and retry once
    config show|backlog      The merged config, and where deferred work goes
    auth status              Which Apps are configured, and where installed
    auth login               Register a GitHub App and install it
    auth install             Install an already-registered App somewhere
    auth rotate              Replace an App's private key, guided
    auth refresh             Refresh a rotating harness credential (the refresher job)
    doctor                   Check that everything crossrev needs is installed
    version                  Print the installed version

  OPTIONS on cycle, review and resolve
    --harness claude|codex   Override the harness the config names for that leg
    --repo owner/name        Target another repository than this checkout
    --no-tips                Suppress the automated-mode suggestion

  Automated mode needs a GitHub App. Local runs do not — they use the gh
  authentication you already have.

EOF
}

# The parse rule, written down rather than discovered later:
#
#   If the first argument begins with `-`, it is the default cycle. Otherwise it
#   is a subcommand, and an unknown subcommand is an error.
#
# So `crossrev --pr 3` cycles, and `crossrev reviw --pr 3` dies naming the typo
# rather than silently running the most expensive operation the tool offers.
# Help and version are special-cased ahead of the rule, because they are the two
# dash-arguments nobody means as a cycle. Bare `crossrev` prints help; it does not
# cycle.
main() {
  case "${1:-}" in
    ""|help|--help|-h)    usage; return 0 ;;
    version|--version|-v) crossrev_version; echo; return 0 ;;
  esac

  local cmd
  if [[ "$1" == -* ]]; then
    cmd="cycle"                 # no shift: the options are the cycle's own
  else
    cmd="$1"; shift
  fi

  case "$cmd" in
    auth)
      local sub="${1:-status}"
      [[ $# -gt 0 ]] && shift
      case "$sub" in
        status)  auth_status "$@" ;;
        login)   auth_login "$@" ;;
        install) auth_install "$@" ;;
        rotate)  auth_rotate "$@" ;;
        refresh) auth_refresh "$@" ;;
        *) ui_die "unknown auth command: $sub" "Try: crossrev auth status | login | install | rotate | refresh" ;;
      esac ;;

    config)
      preflight_require_yq
      cfg_load ""
      case "${1:-show}" in
        show)  jq . <<<"$CFG_MERGED" ;;
        backlog) ui_say "deferred work would go to: $(cfg_resolve_backlog "" "$(cfg_get '.backlog.destination')")" ;;
        *) ui_die "unknown config command: $1" "Try: crossrev config show | backlog" ;;
      esac ;;

    doctor)
      local doctor_ok=0
      preflight_check harness || doctor_ok=1
      preflight_check_quarantine || doctor_ok=1
      # Which pairings the configured runner can serve is the other half of "is
      # this set up correctly", and it is invisible until a CI run fails to
      # authenticate. Reported here rather than discovered there.
      if command -v yq >/dev/null 2>&1; then
        cfg_load ""
        preflight_report_pairings "$(cfg_get '.runner')" || doctor_ok=1
      fi
      preflight_report_worktrees
      if (( doctor_ok == 0 )); then
        ui_end "Everything CrossRev needs is installed."
      else
        ui_end "Fix what is marked ✗ above, then run this again."
        return 1
      fi ;;

    cycle)   cmd_cycle "$@" ;;
    review)  leg_review "$@" ;;
    resolve) leg_resolve "$@" ;;
    status)   cmd_status "$@" ;;
    init)     cmd_init "$@" ;;
    watchdog) cmd_watchdog "$@" ;;

    *) ui_die "unknown command: $cmd" "Run: crossrev help" ;;
  esac
}

main "$@"
