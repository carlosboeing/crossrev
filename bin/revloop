#!/usr/bin/env bash
#
# revloop — cross-model PR review loop.
#
# One model reviews a pull request, a second verifies and addresses each
# finding, then the first looks again. Runs from a terminal against any PR you
# can already see, and on GitHub Actions once `revloop init` has set it up.

set -euo pipefail

# install.sh symlinks this into PATH, so BASH_SOURCE is usually a symlink and
# lib/ is relative to the real file. BSD readlink has no -f, so walk it.
_resolve() {
  local src="$1" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

ROOT="$(cd "$(_resolve "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ROOT

# shellcheck source=lib/ui.sh
source "$ROOT/lib/ui.sh"
# shellcheck source=lib/preflight.sh
source "$ROOT/lib/preflight.sh"
# shellcheck source=lib/auth.sh
source "$ROOT/lib/auth.sh"
# shellcheck source=lib/config.sh
source "$ROOT/lib/config.sh"
# shellcheck source=lib/sandbox.sh
source "$ROOT/lib/sandbox.sh"
# shellcheck source=lib/state.sh
source "$ROOT/lib/state.sh"
# shellcheck source=lib/legs.sh
source "$ROOT/lib/legs.sh"
# shellcheck source=lib/github.sh
source "$ROOT/lib/github.sh"
# shellcheck source=lib/validate.sh
source "$ROOT/lib/validate.sh"
# shellcheck source=lib/prompt.sh
source "$ROOT/lib/prompt.sh"
# shellcheck source=lib/run.sh
source "$ROOT/lib/run.sh"
# shellcheck source=lib/init.sh
source "$ROOT/lib/init.sh"
# shellcheck source=lib/adapters/claude.sh
source "$ROOT/lib/adapters/claude.sh"
# shellcheck source=lib/adapters/codex.sh
source "$ROOT/lib/adapters/codex.sh"

revloop_version() { tr -d '[:space:]' <"$ROOT/VERSION"; }

usage() {
  cat <<'EOF'

  revloop — cross-model PR review loop

  Review a pull request with one model, address the findings with another.

  USAGE
    revloop <command> [options]

  COMMANDS
    review --pr <n>          One review pass: post findings as inline comments
    address --pr <n>          Verify each finding, fix or push back, reply, push
    run --pr <n>             The whole loop in one process, up to max_passes
    status --pr <n>          Read the loop's state off the pull request
    init                     Set up automated mode: App, secrets, labels, workflows
    watchdog                 Find pull requests stuck waiting on a leg, and retry once
    config show|sink         The merged config, and where deferred work goes
    auth status              Which Apps are configured, and where installed
    auth login               Register a GitHub App and install it
    auth install             Install an already-registered App somewhere
    doctor                   Check that everything revloop needs is installed
    version                  Print the installed version

  OPTIONS on review, address and run
    --harness claude|codex   Override the harness the config names for that leg
    --repo owner/name        Target another repository than this checkout
    --no-tips                Suppress the automated-mode suggestion

  Automated mode needs a GitHub App. Local runs do not — they use the gh
  authentication you already have.

EOF
}

main() {
  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift

  case "$cmd" in
    auth)
      local sub="${1:-status}"
      [[ $# -gt 0 ]] && shift
      case "$sub" in
        status)  auth_status "$@" ;;
        login)   auth_login "$@" ;;
        install) auth_install "$@" ;;
        rotate)
          ui_die "\`revloop auth rotate\` is not built yet" \
            "GitHub has no API to generate an App private key — it is a web-UI action. Until this lands, generate one at https://github.com/settings/apps and replace the file that \`revloop auth status\` names." ;;
        *) ui_die "unknown auth command: $sub" "Try: revloop auth status | login | install" ;;
      esac ;;

    config)
      preflight_require_yq
      cfg_load ""
      case "${1:-show}" in
        show)  jq . <<<"$CFG_MERGED" ;;
        sink)  ui_say "deferred work would go to: $(cfg_resolve_sink "" "$(cfg_get '.persist.defects')")" ;;
        *) ui_die "unknown config command: $1" "Try: revloop config show | sink" ;;
      esac ;;

    doctor)
      preflight_check harness && ui_end "Everything revloop needs is installed." \
        || ui_end "Install what is marked ✗ above, then run this again." ;;

    review)  leg_review "$@" ;;
    address) leg_address "$@" ;;
    run)     cmd_run "$@" ;;
    status)   cmd_status "$@" ;;
    init)     cmd_init "$@" ;;
    watchdog) cmd_watchdog "$@" ;;

    version|--version|-v) revloop_version; echo ;;
    help|--help|-h) usage ;;
    *) ui_die "unknown command: $cmd" "Run: revloop help" ;;
  esac
}

main "$@"
