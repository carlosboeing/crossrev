.DS_Store
*.swp

# The private workbench is an independent clone nested here. This line is the
# strongest layer of the public/private gate: `git add -A` at this root can
# never sweep a workbench file into a public commit.
.workbench/

# Local git worktrees, per the shared convention.
.worktrees/
.claude/worktrees/

# Transient quarantine directory
.crossrev-quarantine/

# Native build output. scripts/build-native.sh takes the path as an argument and
# scripts/test-native.sh passes .tmp/crossrev-native; a 12 MB binary is not a
# tracked file.
.tmp/

# package.json exists for npm distribution only. There is no dependency tree
# to lock, and the repo has no package manager step.
package-lock.json
