      "command": "cycle",
      "request": {"PR": "42", "Repo": "owner/name", "Trigger": "automatic", "HarnessOverride": "codex", "NoTips": "true", "KeepTranscripts": "true"}
    },
    {
      "name": "the last --pr wins",
      "args": ["cycle", "--pr", "1", "--pr", "42"],
      "command": "cycle",
      "request": {"PR": "42", "Repo": "", "Trigger": "human", "HarnessOverride": "", "NoTips": "false", "KeepTranscripts": "false"}
    },

