    {
      "name": "a leading dash is the default cycle, and the options are the cycle's own",
      "args": ["--pr", "42"],
      "command": "cycle",
      "request": {"PR": "42", "Repo": "", "Trigger": "human", "HarnessOverride": "", "NoTips": "false", "KeepTranscripts": "false"}
    },
    {
      "name": "cycle named explicitly",
      "args": ["cycle", "--pr", "42"],
      "command": "cycle",
      "request": {"PR": "42", "Repo": "", "Trigger": "human", "HarnessOverride": "", "NoTips": "false", "KeepTranscripts": "false"}
    },
    {
      "name": "cycle with every flag it takes",
      "args": ["cycle", "--pr", "42", "--repo", "owner/name", "--harness", "codex", "--trigger", "automatic", "--no-tips", "--keep-transcripts"],
      "command": "cycle",
      "request": {"PR": "42", "Repo": "owner/name", "Trigger": "automatic", "HarnessOverride": "codex", "NoTips": "true", "KeepTranscripts": "true"}
    },
    {
