#!/usr/bin/env bash
#
# pre-push — refuse a push whose project records are stale.
#
# git feeds this hook one line per ref on stdin:
#     <local ref> <local sha> <remote ref> <remote sha>
# A new branch arrives with an all-zero remote sha, so there is no remote
# ancestor to diff against. Fall back to the merge base with origin/HEAD.
#
# Deliberate override, for the push that is genuinely fine:
#     git push --no-verify
#
# Install: see the README beside this file.

set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ZERO='0000000000000000000000000000000000000000'
rc=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # a delete, nothing to check
  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null \
            || git rev-list --max-parents=0 "$local_sha" | tail -1)"
  else
    base="$remote_sha"
  fi
  "$HERE/housekeep" check --push "$base" "$local_sha" || rc=1
done

exit $rc
